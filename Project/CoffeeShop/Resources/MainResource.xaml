<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#EDE2D3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Margin="2">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="true"
                               Focusable="false">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Visibility="Collapsed"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBorder"
                                                    Background="#D4BA98"
                                                    CornerRadius="5"
                                                    Margin="2"
                                                    SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder"
                                                            Property="Background"
                                                            Value="#D4BA98"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumbBorder"
                                                            Property="Background"
                                                            Value="#D4BA98"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Visibility="Collapsed"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Datagrid template -->
    <Style x:Key="CoffeeDataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="Background" Value="#E0CEB5"/>
        <Setter Property="Foreground" Value="#FF340D05"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="#5D522C"/>
    </Style>

    <Style x:Key="CoffeeDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#766839"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="0,0,0.5,0.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Padding="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EDE2D3"/>
                <Setter Property="Foreground" Value="#340D05"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CoffeeDataGridStyle" TargetType="DataGrid" BasedOn="{x:Null}">
        <Setter Property="CellStyle" Value="{StaticResource CoffeeDataGridCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CoffeeDataGridHeaderStyle}"/>
        <Setter Property="Background" Value="#F9F6F0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="RowBackground" Value="#F9F6F0"/>
        <Setter Property="AlternatingRowBackground" Value="#F2EDE4"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="15" Margin="1"
                            ClipToBounds="True">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" 
                                                                    Grid.Row="0" Grid.Column="0"
                                                                    Visibility="{Binding HeadersVisibility, RelativeSource={RelativeSource TemplatedParent}}"/>

                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                            Grid.Row="1" Grid.Column="0"
                                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                               Grid.Row="1" Grid.Column="1"
                                               Orientation="Vertical"
                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                               Maximum="{TemplateBinding ScrollableHeight}"
                                               Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                               Width="8" Margin="2,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>

                        <Border BorderBrush="#B18252" 
                            BorderThickness="7" 
                            CornerRadius="15" 
                            IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded ProgressBar -->
    <Style x:Key="RoundedProgressBar" TargetType="{x:Type ProgressBar}" BasedOn="{x:Null}">
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#EEE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"/>

                        <Border x:Name="PART_Indicator" 
                            HorizontalAlignment="Left" 
                            CornerRadius="7" 
                            Background="{Binding PerformanceColor}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>