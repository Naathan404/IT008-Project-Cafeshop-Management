<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Template cho nút trong kho -->
    <ControlTemplate x:Key="depotButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
             BorderBrush="#340D05"
                BorderThickness="1"
             CornerRadius="5"
             Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                       Content="{TemplateBinding Content}"/>
        </Border>
    </ControlTemplate>

    <!-- Style cho nút trong kho -->
    <Style x:Key="depotButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource depotButtonTemplate}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="#C7A57A"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Style DataGrid áp dụng HeaderTemplate -->
    <Style x:Key="dgHeaderTemplate" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E0CEB5"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="0.6"/>
    </Style>

    <!-- Style cho datagrid cell -->
    <ControlTemplate x:Key="dgCellTemplate" TargetType="{x:Type DataGridCell}">
        <Border 
             BorderBrush="{TemplateBinding BorderBrush}" 
             BorderThickness="{TemplateBinding BorderThickness}" 
             Background="{TemplateBinding Background}" 
             Padding="{TemplateBinding Padding}">

            <ContentPresenter 
                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                 VerticalAlignment="Center"  HorizontalAlignment="Stretch"/>
        </Border>
    </ControlTemplate>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template" Value="{StaticResource dgCellTemplate}"></Setter>
    </Style>
</ResourceDictionary>