<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Template cho nút trong kho -->
    <ControlTemplate x:Key="depotButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
            BorderBrush="#340D05"
            BorderThickness="1.5"
            CornerRadius="5"
            Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                Content="{TemplateBinding Content}"/>
        </Border>
    </ControlTemplate>

    <!-- Style cho nút trong kho -->
    <Style x:Key="depotButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource depotButtonTemplate}"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="10,0,10,0"/>
        <Setter Property="Background" Value="#C7A57A"/>
        <Setter Property="Foreground" Value="#F9F6F0"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <!-- Style DataGrid áp dụng HeaderTemplate -->
    <Style x:Key="dgHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E0CEB5"/>
        <Setter Property="Foreground" Value="#340D05"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#340D05"/>
        <Setter Property="BorderThickness" Value="0.6"/>
    </Style>

    <!-- Style cho datagrid cell -->
    <!-- Template -->
    <ControlTemplate x:Key="dgCellTemplate" TargetType="{x:Type DataGridCell}">
        <Border 
             BorderBrush="{TemplateBinding BorderBrush}" 
             BorderThickness="{TemplateBinding BorderThickness}" 
             Background="{TemplateBinding Background}" 
             Padding="{TemplateBinding Padding}">

            <ContentPresenter 
                 SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                 VerticalAlignment="Center"  HorizontalAlignment="Stretch"/>
        </Border>
    </ControlTemplate>

    <!-- Style -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="#F9F6F0"/>
        <Setter Property="BorderBrush" Value="#766839"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="Template" Value="{StaticResource dgCellTemplate}"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <!-- Thay đổi màu chữ khi chọn -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EDE2D3"/>
                <Setter Property="Foreground" Value="#340D05"/>

            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!-- Style cho datagrid row -->
    <Style TargetType="DataGridRow">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</ResourceDictionary>