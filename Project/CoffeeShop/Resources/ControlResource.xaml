<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="BrownButtonTemplate_1" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
            BorderBrush="#FF340D05"
            BorderThickness="1"
            CornerRadius="10"
            Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                Content="{TemplateBinding Content}"/>
        </Border>
    </ControlTemplate>
    
    <Style x:Key="BrownButtonStyle_1" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource BrownButtonTemplate_1}"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="#C7A57A"/>
        <Setter Property="Foreground" Value="#F9F6F0"/>
        <Setter Property="FontFamily" Value="Cascadia Code"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>