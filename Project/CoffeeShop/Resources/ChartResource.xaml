<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <Style x:Key="PieChartCustomStyle" TargetType="lvc:PieChart">
        <Setter Property="LegendLocation" Value="Bottom"></Setter>
        <Setter Property="InnerRadius" Value="36"></Setter>
        <Setter Property="Hoverable" Value="True"></Setter>
        <Setter Property="HoverPushOut" Value="10"></Setter>
        <Setter Property="AnimationsSpeed" Value="0:0:0.15"></Setter>
        <Setter Property="Margin" Value="0 20 0 0"></Setter>
        <Setter Property="StartingRotationAngle" Value="0"></Setter>
    </Style>
</ResourceDictionary>