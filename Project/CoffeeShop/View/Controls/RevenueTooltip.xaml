<UserControl x:Class="CoffeeShop.View.Controls.RevenueTooltip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CoffeeShop.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200">
    <Grid>
        <Border Background="White" CornerRadius="8" Padding="10" Opacity="0.95" BorderBrush="#E0CEB5" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.4"/>
            </Border.Effect>

            <ItemsControl ItemsSource="{Binding Data.Points}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Series.Title}" Value="Tốc độ tăng trưởng:">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Ellipse Width="10" Height="10" Fill="{Binding Series.Fill}" Margin="0,0,8,0"/>

                            <TextBlock Text="{Binding Series.Title}" 
                                       Foreground="#FF340D05" 
                                       FontWeight="Bold" 
                                       Margin="0,0,5,0"
                                       FontFamily="Cascadia Code"/>

                            <TextBlock Text="{Binding ChartPoint.Y, StringFormat={}{0:N0}}" 
                                       Foreground="#FF340D05" 
                                       FontWeight="Bold"
                                       FontFamily="Cascadia Code"/>

                            <TextBlock Text=" "/>

                            <TextBlock Foreground="#FF340D05" 
                                       FontStyle="Italic"
                                       FontFamily="Cascadia Code">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ChartPoint.Participation, StringFormat={}({0:P1})}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Series.Title}" Value="Tổng:">
                                                <Setter Property="Text" Value="(100%)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
