<Window x:Class="CoffeeShop.View.Staff.ItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop.View.Staff"
        mc:Ignorable="d"
        Title="{Binding ItemName}"
        d:Title="Item Window"
        Height="350" Width="600"
        Icon="/Assets/icoCoffee.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E0CEB5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="10 30 10 30">
            <TextBlock Text="{Binding ItemName}"
                       d:Text="Cà phê sữa"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       MaxWidth="250"
                       Foreground="#766839"
                       FontSize="30" FontFamily="Cascadia Code" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="20 50 20 0">
                <TextBlock Text="Size:"
                           Foreground="#766839"
                           FontSize="25" FontFamily="Cascadia Code"/>
                <!--Item Size-->
                <StackPanel x:Name="stpnItemSize" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="10 0 0 0">
                    <Border x:Name="bdrItemSizeS"
                            BorderBrush="#766839"
                            BorderThickness="2.5"
                            CornerRadius="15"
                            Width="30"
                            Height="30"
                            MouseDown="bdrItemSizeS_MouseDown"
                            MouseEnter="bdrItemSize_MouseEnter">
                        <TextBlock Text="S"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Bahnschrift"
                                   Foreground="#766839"/>
                    </Border>
                    <Border x:Name="bdrItemSizeM"
                            BorderBrush="#766839"
                            BorderThickness="2"
                            CornerRadius="15"
                            Width="30"
                            Height="30"
                            Margin="2.5"
                            MouseDown="bdrItemSizeM_MouseDown"
                            MouseEnter="bdrItemSize_MouseEnter">
                        <TextBlock Text="M"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Bahnschrift"
                                   Foreground="#766839"/>
                    </Border>
                    <Border x:Name="bdrItemSizeL"
                            BorderBrush="#766839"
                            BorderThickness="2"
                            CornerRadius="15"
                            Width="30"
                            Height="30"
                            MouseDown="bdrItemSizeL_MouseDown"
                            MouseEnter="bdrItemSize_MouseEnter">
                        <TextBlock Text="L"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Bahnschrift"
                                   Foreground="#766839"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Vertical">
            <!--Item Image-->
            <Border Width="270" Margin="10">
                <Image x:Name="imgItem"
                       Stretch="UniformToFill"
                       Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                       d:Source="/Assets/Images/imgItemExample.jpg"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="bdrAddToOrder"
                        BorderBrush="#766839"
                        BorderThickness="2"
                        Width="100" Height="40" Margin="0 20 30 10"
                        CornerRadius="12"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="Thêm"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Code"
                               Foreground="#766839"
                               MouseDown="bdrExit_MouseDown"
                               MouseEnter="bdrExit_MouseEnter"
                               Margin="10"/>
                </Border>
                <Border x:Name="bdrExit"
                        BorderBrush="#766839"
                        BorderThickness="2"
                        Width="100" Height="40" Margin="0 20 30 10"
                        CornerRadius="12"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        MouseDown="bdrExit_MouseDown"
                        MouseEnter="bdrExit_MouseEnter">
                    <TextBlock Text="Thoát"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Cascadia Code"
                               Foreground="#766839"
                               MouseDown="bdrExit_MouseDown"
                               MouseEnter="bdrExit_MouseEnter"
                               Margin="10"/>
                </Border>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
