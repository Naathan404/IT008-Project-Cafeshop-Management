<Window x:Class="CoffeeShop.View.Staff.DepotHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:CoffeeShop.View.Staff"
        mc:Ignorable="d"
        Title="Lịch sử chỉnh sửa kho" Height="700" Width="1100">
    <Grid x:Name="MainGrid" Background="#E0CEB5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- popup filter -->
        <Border x:Name="popupFilterBorder" 
            Visibility="{Binding PopupVisibleState}" 
            Background="#F9F6F0" BorderBrush="#340D05" BorderThickness="1" 
            Grid.Row="1" Grid.ColumnSpan="2"
            HorizontalAlignment="Right" VerticalAlignment="Top" 
            Width="300" Height="300" Panel.ZIndex="10" Margin="0,50,60,0"
            CornerRadius="7" Padding="15">
            <StackPanel Orientation="Vertical">
                <!-- Quantity Filter -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Lọc theo Số lượng" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Từ:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txbQuantityMin" Grid.Column="1" Margin="0,0,10,0" Width="Auto" Text="{Binding MinQuantity}"/>

                        <TextBlock Text="Đến:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txbQuantityMax" Grid.Column="3" Width="Auto" Text="{Binding MaxQuantity}"/>
                    </Grid>
                </StackPanel>

                <!-- Price Filter -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Lọc theo Giá" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Từ:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txbPriceMin" Grid.Column="1" Margin="0,0,10,0" Width="Auto" Text="{Binding MinPrice}"/>

                        <TextBlock Text="Đến:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txbPriceMax" Grid.Column="3" Width="Auto" Text="{Binding MaxPrice}"/>
                    </Grid>
                </StackPanel>
                
                <!-- ActionType Filter -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Lọc theo Hành động" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbActionFilter" ItemsSource="{Binding actionTypes}" SelectedItem="{Binding SelectedAction}"/>

                    <!-- The combobox that contains all the unit to filter -->
                </StackPanel>

                <!-- Staff Filter -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Lọc theo Nhân viên" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbStaffFilter" ItemsSource="{Binding staffNames}" SelectedItem="{Binding SelectedStaff}"/>

                    <!-- The combobox that contains all the unit to filter -->
                </StackPanel>

                <Separator Margin="0,5"/>
                <Grid>
                    <Button x:Name="btnClearFilter" 
                        Content="Bỏ lọc" Margin="0,15,0,0" Padding="5"
                        BorderBrush="Transparent" Background="#B18252"
                        Height="40" Width="100"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearFilterCommand}"/>
                    <Button x:Name="btnApplyFilter" 
                        Content="Áp dụng" Margin="0,15,0,0" Padding="5"
                        BorderBrush="Transparent" Background="#B18252"
                        Height="40" Width="100"
                        HorizontalAlignment="Right"
                        Command="{Binding ApplyFilterCommand}"/>
                </Grid>
            </StackPanel>
        </Border>


        <Border Grid.Column="0" BorderBrush="#bc9466" BorderThickness="10" CornerRadius="10" Margin="15">
            <DataGrid x:Name="dgDepot" SelectionMode="Single"
                ColumnHeaderStyle="{StaticResource dgHeaderStyle}"
                Background="#F9F6F0"
                AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserResizeColumns="False" CanUserReorderColumns="False"
                HorizontalAlignment="Stretch"
                GridLinesVisibility="None"
                IsReadOnly="true" ItemsSource="{Binding depotHistoryItems}">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên material"  Binding="{Binding MaterialName}" Width="1.4*"/>
                    <DataGridTextColumn Header="Hành động" Binding="{Binding ActionName}" Width="0.7*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:G2}}" Width="0.7*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="0.8*"/>
                    <!-- <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="0.7*"> 
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn> -->
                    <DataGridTextColumn Header="Tên NV" Binding="{Binding StaffName}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <materialDesign:Card Grid.Column="1"
             Height="210" Margin="0,15,15,0"
             VerticalAlignment="Top"
             UniformCornerRadius="10">
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="10,10,10,0">
                    <!-- Filter -->
                    <Border VerticalAlignment="Top"
                    Background="#B18252" BorderThickness="1" BorderBrush="Black"
                    CornerRadius="5" DockPanel.Dock="Right">
                        <Button Height="50" Width="50" Command="{Binding TogglePopupCommand}">
                            <Border x:Name="bdrFilter">
                                <materialDesign:PackIcon Kind="Filter" Height="30" Width="30"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="#F9F6F0"/>
                            </Border>
                        </Button>
                    </Border>

                    <!-- Search bar -->
                    <TextBox x:Name="txbSearchBar"
                    Margin="0 0 5 0" Height="50"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Tìm kiếm"
                    materialDesign:HintAssist.Foreground="#462812"
                    materialDesign:HintAssist.Background="Transparent"
                    materialDesign:TextFieldAssist.UnderlineBrush="#462812"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                    BorderThickness="1"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
                <!-- DATE FILTER-->
                <Grid Grid.Row="1" Margin="10,15,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"></RowDefinition>
                        <RowDefinition Height="7*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Thời gian:"
                        Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="20" FontWeight="Bold">
                    </TextBlock>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52*"></ColumnDefinition>
                            <ColumnDefinition Width="9*"></ColumnDefinition>
                            <ColumnDefinition Width="52*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="dateStartDate"
                              Width="100"
                              BorderThickness="2"
                              materialDesign:HintAssist.Hint="Pick Date"
                              SelectedDate="{Binding StartDateFilter}"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>            

                        <TextBlock Grid.Column ="1"
                            Text=" _ "
                            FontSize="10"
                            FontFamily="Cascadia Code"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Foreground="#FF340D05">
                        </TextBlock>
                        <DatePicker x:Name="dateEndDate"
                              Width="100" Grid.Column="2"
                              BorderThickness="2"
                              materialDesign:HintAssist.Hint="Pick Date"
                              SelectedDate="{Binding EndDateFilter}"
                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
