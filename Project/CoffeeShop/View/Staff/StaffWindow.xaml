<Window x:Class="CoffeeShop.View.Staff.StaffWindow"
        x:Name="Cafeshop___Staff" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Coffeeshop - Staff"
        Icon="/CoffeeShop;component/Assets/icoCoffee.ico"
        WindowState="Maximized"
        Height="520" Width="850"
        MinHeight="520" MinWidth="850" 
        BorderBrush="#FF340D05" 
        Foreground="#FFC7A57A" 
        PreviewMouseDown="PreviewMouseDownEvt">
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#EDE2D3">
        <Frame x:Name="StaffFrame"
               HorizontalAlignment="Stretch"
               Margin="80 0 0 0"
               NavigationUIVisibility="Hidden"/>
        <Grid>
            <Border x:Name="bdrStaffWindowFunction"
                    Background="#C7A57A"
                    Width="180"
                    HorizontalAlignment="Left"
                    Mouse.MouseDown="bdrStaffWindowFunction_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#462812"
                                      Opacity="0.4"
                                      BlurRadius="10"
                                      ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <!-- Hiện tên account nhân viên -->
                    <Border x:Name="bdrAccount_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            Margin="12 12 0 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Margin="10 10 0 0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Height="35" Width="35"
                                                     Foreground="#462812"/>
                            <TextBlock x:Name="txblAccountName1"
                                       Text="Account Name"
                                       Margin="50,19,12,0"
                                       FontFamily="Cascadia Code"
                                       FontSize="16"
                                       Foreground="#391B05" 
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>
                    <Border x:Name="bdrAccount_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12,12,0,330">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Margin="10"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Height="35" Width="35"
                                                 Foreground="#391B05"/>
                    </Border>

                    <!-- Tab Order -->
                    <Border x:Name="bdrOrder_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,330">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Image Source="/Assets/Images/imgCoffeeOrder.jpg"
                               Height="35" Width="35"
                               Margin="10"/>
                    </Border>
                    <Border x:Name="bdrOrder_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,330"
                            Mouse.MouseDown="bdrOrder_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <Image Source="/Assets/Images/imgCoffeeOrder.jpg"
                                   Height="35" Width="35"
                                   HorizontalAlignment="Left"
                                   Margin="10"/>
                            <TextBlock Text="Đặt đơn"
                                       Margin="50 17 25 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="21"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tab Bàn -->
                    <Border x:Name="bdrTable_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,260">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="TableFurniture"
                                                    Height="35" Width="35"
                                                    Margin="10"
                                                    Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrTable_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,260"
                            Mouse.MouseDown="bdrTable_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="TableFurniture"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Bàn ăn"
                                       Margin="50 17 25 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="21"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Tab Menu -->
                    <Border x:Name="bdrMenu_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,190">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Menu"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrMenu_After"
                            Background="#E0CEB5"
                            Height="55"                                    
                            CornerRadius="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,190"
                            Mouse.MouseDown="bdrMenu_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="Menu"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Thực đơn"
                                       Margin="50 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="21"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tab Kho -->
                    <Border x:Name="bdrDepot_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,120">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="ArchiveOutline"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrDepot_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,120"
                            Mouse.MouseDown="bdrDepot_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="ArchiveOutline"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Kho hàng"
                                       Margin="50 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="21"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Tab Thống Kê -->
                    <Border x:Name="bdrStatistics_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,50">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="ChartBoxOutline"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrStatistics_After"
                            Background="#E0CEB5"
                            Height="55" 
                            CornerRadius="28"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,50"
                            Mouse.MouseDown="bdrStatistics_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>

                            <materialDesign:PackIcon Kind="ChartBoxOutline"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Thống kê"
                                       Margin="50 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="21"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
