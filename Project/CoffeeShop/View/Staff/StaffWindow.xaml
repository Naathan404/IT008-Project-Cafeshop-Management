<Window x:Class="CoffeeShop.View.Staff.StaffWindow"
        x:Name="Cafeshop___Staff" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="2G1G Café"
        Icon="/CoffeeShop;component/Assets/icoCoffee.ico"
        WindowState="Maximized"
        Height="610" Width="1110"
        MinHeight="610" MinWidth="1110" 
        BorderBrush="#FF340D05" 
        Foreground="#FFC7A57A" 
        >
    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#EDE2D3"
          PreviewMouseDown="PreviewMouseDownEvt">
        <Frame x:Name="StaffFrame"
               HorizontalAlignment="Stretch"
               Margin="80 0 0 0"
               NavigationUIVisibility="Hidden"/>
        <Grid>
            <Border x:Name="bdrStaffWindowFunction"
                    Background="#C7A57A"
                    Width="180"
                    HorizontalAlignment="Left"
                    Mouse.MouseDown="bdrStaffWindowFunction_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#462812"
                                      Opacity="0.4"
                                      BlurRadius="10"
                                      ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <!-- Hiện tên account nhân viên -->
                    <Border x:Name="bdrAccount_After"
                            Background="#E0CEB5"
                            Height="55" 
                            CornerRadius="28"
                            Margin="12 12 12 330"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Mouse.MouseDown="bdrAccount_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>

                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                     Margin="10 10 0 0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Height="35" Width="35"
                                                     Foreground="#462812"/>
                            <TextBlock x:Name="txblAccountName1"
                                       Text="TÀI KHOẢN"
                                       Margin="52,17,10,0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#391B05" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>
                    <Border x:Name="bdrAccount_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12,12,0,330">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Margin="10"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Height="35" Width="35"
                                                 Foreground="#391B05"/>
                    </Border>

                    <!-- Tab Order -->
                    <Border x:Name="bdrOrder_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,360">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Image Source="/Assets/Images/imgCoffeeOrder.jpg"
                               Height="35" Width="35"
                               Margin="10"/>
                    </Border>
                    <Border x:Name="bdrOrder_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,360"
                            Mouse.MouseDown="bdrOrder_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <Image Source="/Assets/Images/imgCoffeeOrder.jpg"
                                   Height="35" Width="35"
                                   HorizontalAlignment="Left"
                                   Margin="10"/>
                            <TextBlock Text="Đặt đơn"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Tab Bàn -->
                    <Border x:Name="bdrTable_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,290">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Seat"
                                                    Height="35" Width="35"
                                                    Margin="10"
                                                    Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrTable_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,290"
                            Mouse.MouseDown="bdrTable_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="SeatOutline"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Bàn ăn"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Tab Menu -->
                    <Border x:Name="bdrMenu_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,220">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Food"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrMenu_After"
                            Background="#E0CEB5"
                            Height="55"               
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,220"
                            Mouse.MouseDown="bdrMenu_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="FoodOutline"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Thực đơn"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Tab khách hàng -->
                    <Border x:Name="bdrCustomer_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,150">     
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                          Opacity="0.3"
                          BlurRadius="-10"
                          ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="AccountGroup"
                             Height="35" Width="35"
                             Margin="10"
                             Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrCustomer_After"
                            Background="#E0CEB5"
                            Height="55" 
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,150"
                            Mouse.MouseDown="bdrCustomer_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                          Opacity="0.3"
                          BlurRadius="-10"
                          ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>

                            <materialDesign:PackIcon Kind="AccountGroupOutline"
                                 Height="35" Width="35"
                                 Margin="10"
                                 Foreground="#340D05"/>
                            <TextBlock Text="Thành viên"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="18"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>
                    

                    <!-- Tab Lịch sử mua hàng -->
                    <Border x:Name="bdrHistory_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,80">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="History"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrHistory_After"
                            Background="#E0CEB5"
                            Height="55" 
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,80"
                            Mouse.MouseDown="bdrHistory_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>

                            <materialDesign:PackIcon Kind="History"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Lịch sử"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Tab Kho -->
                    <Border x:Name="bdrDepot_Before"
                            Background="#E0CEB5"
                            CornerRadius="30"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Archive"
                                                 Height="35" Width="35"
                                                 Margin="10"
                                                 Foreground="#340D05"/>
                    </Border>
                    <Border x:Name="bdrDepot_After"
                            Background="#E0CEB5"
                            Height="55"
                            CornerRadius="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="12,0,12,10"
                            Mouse.MouseDown="bdrDepot_MouseDown"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#462812"
                                              Opacity="0.3"
                                              BlurRadius="-10"
                                              ShadowDepth="5"/>
                        </Border.Effect>
                        <Grid>
                            <materialDesign:PackIcon Kind="ArchiveOutline"
                                                     Height="35" Width="35"
                                                     Margin="10"
                                                     Foreground="#340D05"/>
                            <TextBlock Text="Kho hàng"
                                       Margin="60 17 10 0"
                                       FontFamily="Cascadia Code"
                                       FontSize="20"
                                       Foreground="#462812" 
                                       FontWeight="Bold"
                                       TextAlignment="Left"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
