<Page x:Class="CoffeeShop.View.Staff.Staff_Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:CoffeeShop.View.Staff"
      xmlns:vm="clr-namespace:CoffeeShop.ViewModels.StaffVM"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1310"
      MinHeight="0" MinWidth="1000"
      Title="Staff_Order">

    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
        <local:AndBooleanConverter x:Key="AndBooleanConverter"/>

        <!-- Style for Item card -->
        <Style x:Key="RoundedCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="BorderContainer"
                                Background="#E0CEB5" CornerRadius="15"
                                MinWidth="130" MinHeight="150" 
                                MaxHeight="220" MaxWidth="200"
                                MouseDown="Item_MouseDown"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><!-- Ảnh -->
                                    <RowDefinition Height="Auto"/><!-- Tên -->
                                    <RowDefinition Height="*"/><!-- EMPTY SPACE -->
                                    <RowDefinition Height="Auto"/><!-- Size -->
                                    <RowDefinition Height="Auto"/><!-- Giá -->
                                </Grid.RowDefinitions>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Grid.Row="0"
                                       Margin="10" MaxHeight="80"
                                       Stretch="UniformToFill"
                                       Source="{Binding ImagePath}"
                                       d:Source="/Assets/Images/imgItemExample.jpg"/>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding ItemName}"
                                           Grid.Row="1"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 10 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Grid Grid.Row="2"></Grid>
                                
                                <!-- Item Size -->
                                <ItemsControl Grid.Row="3"
                                              ItemsSource="{Binding ItemPrices}"
                                              Margin="0 5 10 0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CategoryId}" Value="7"/>
                                                        <Condition Binding="{Binding ItemPrices.Count}" Value="1"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#766839"
                                                    BorderThickness="2"
                                                    CornerRadius="15"
                                                    Width="20" Height="20"
                                                    Margin="0 0 2.5 0"
                                                    MouseDown="bdrItemSize_MouseDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#D4BA98"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Size.SizeName}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Bahnschrift"
                                                           Foreground="#766839">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground" Value="#340D05"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!--Item Price-->
                                <TextBlock x:Name="txtblItemPrice"
                                           Grid.Row="4"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 5"
                                           HorizontalAlignment="Right"
                                           Loaded="ItemPrice_Loaded"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#340D05" 
                                                          Direction="315" 
                                                          ShadowDepth="3" 
                                                          BlurRadius="10" 
                                                          Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Style cho TabControl (xuống dòng khi không đủ độ rộng) -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0"
                                      HorizontalAlignment="Stretch"/>
                            <!-- Tab content -->
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border Background="#D4BA98"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Menu Panel -->
                <Grid Grid.Column="0">
                    <Border x:Name="bdrMenuTab"
                            Margin="15 10 10 15"
                            Background="#EDE2D3"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                        Background="#EDE2D3" 
                                        CornerRadius="15"
                                        BorderBrush="#BC9466"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                    <Grid Margin="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Magnify" 
                                                                 Foreground="#462812" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="0,0,5,0"/>
                                        <TextBox x:Name="txblSearchItem"
                                                 Grid.Column="1"
                                                 Text="{Binding SearchItemKeyword, 
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="10"
                                                 Foreground="#462812"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 materialDesign:HintAssist.Hint="Tìm kiếm tên món..."
                                                 materialDesign:HintAssist.FontFamily="Cascadia Code"
                                                 Style="{StaticResource MaterialDesignTextBox}"/>
                                    </Grid>
                                </Border>

                                <TabControl x:Name="tabMain"
                                            Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            SelectedItem="{Binding SelectedTabItem}">

                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" 
                                                                   FontSize="14"
                                                                   FontFamily="Cascadia Code" 
                                                                   FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.ItemContainerStyle>

                                    <TabItem Header="Tất cả" Tag="0"/>
                                    <TabItem Header="Cà phê" Tag="1"/>
                                    <TabItem Header="Trà sữa" Tag="2"/>
                                    <TabItem Header="Đá xay" Tag="3"/>
                                    <TabItem Header="Trà" Tag="4"/>
                                    <TabItem Header="Nước ép" Tag="5"/>
                                    <TabItem Header="Sinh tố" Tag="6"/>
                                    <TabItem Header="Food" Tag="7"/>
                                </TabControl>
                            </Grid>
                            <Border Grid.Row="1" Margin="10 0 10 10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding FilteredItems}"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  HorizontalAlignment="Stretch"
                                                  SizeChanged="ItemsContainer_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid VerticalAlignment="Top" 
                                                             HorizontalAlignment="Left"
                                                             Width="Auto"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}" Margin="5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Order Panel -->
                <Grid Grid.Column="1">
                    <Border x:Name="bdrOrderBox"
                            Margin="5 10 15 15"
                            Background="#EDE2D3"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Customer & Table Selection -->
                            <StackPanel Orientation="Horizontal" 
                                        Margin="10 5 15 0" 
                                        Grid.Row="0">
                                <ComboBox x:Name="cbTable"
                                          Margin="5"
                                          VerticalAlignment="Center"
                                          FontFamily="Cascadia Code" 
                                          FontSize="15" 
                                          Foreground="#766839"
                                          ItemsSource="{Binding AvailableTables}"
                                          SelectedItem="{Binding SelectedTable}"
                                          DisplayMemberPath="TableName"
                                          materialDesign:HintAssist.Hint="Chọn bàn"
                                          materialDesign:TextFieldAssist.UnderlineBrush="Transparent"/>

                                <Border Background="White" 
                                        CornerRadius="15"
                                        BorderBrush="#BC9466"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Margin="15 0 0 0">
                                    <Grid Margin="10 2 10 2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="AccountSearchOutline" 
                                                                 Foreground="#462812" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="0,0,5,0"/>
                                        <TextBox x:Name="tbCustomerPhone"
                                                 Grid.Column="1"
                                                 Text="{Binding SearchCustomerKeyword, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Foreground="#462812"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 materialDesign:HintAssist.Hint="Tìm kiếm SĐT..."
                                                 materialDesign:HintAssist.FontFamily="Cascadia Code"
                                                 TextChanged="tbCustomerPhone_TextChanged"/>
                                    </Grid>
                                </Border>

                                <!-- Popup hiển thị gợi ý -->
                                <Popup x:Name="popupCustomers"
                                       PlacementTarget="{Binding ElementName=tbCustomerPhone}"
                                       Placement="Bottom"
                                       Width="Auto"
                                       AllowsTransparency="True">
                                    <Popup.IsOpen>
                                        <MultiBinding Converter="{StaticResource AndBooleanConverter}" Mode="OneWay">
                                            <Binding ElementName="tbCustomerPhone" Path="IsKeyboardFocusWithin" />
                                            <Binding Path="HasSearchResults" Mode="OneWay" />
                                        </MultiBinding>
                                    </Popup.IsOpen>
                                    <Border BorderBrush="#766839" 
                                            BorderThickness="2" 
                                            Background="#F9F6F0"
                                            CornerRadius="5"
                                            MaxHeight="250">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#D4BA98" 
                                                                BorderThickness="0 0 0 1"
                                                                Background="Transparent"
                                                                Cursor="Hand"
                                                                MouseDown="CustomerItem_MouseDown"
                                                                MouseEnter="CustomerItem_MouseEnter"
                                                                MouseLeave="CustomerItem_MouseLeave">
                                                            <StackPanel Margin="10 8">
                                                                <TextBlock Text="{Binding CustomerName}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="14"
                                                                           FontFamily="Cascadia Code"
                                                                           Foreground="#766839"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                                                                    <materialDesign:PackIcon Kind="Phone" 
                                                                                             Width="14" Height="14" 
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#766839"
                                                                                             Margin="0 0 5 0"/>
                                                                    <TextBlock Text="{Binding PhoneNumber}" 
                                                                               Foreground="#766839" 
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Code"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                                                    <materialDesign:PackIcon Kind="Email" 
                                                                                             Width="14" Height="14" 
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#766839"
                                                                                             Margin="0 0 5 0"/>
                                                                    <TextBlock Text="{Binding Email}" 
                                                                               Foreground="#766839" 
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Code"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                                                    <materialDesign:PackIcon Kind="Star" 
                                                                                             Width="14" Height="14" 
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#766839"
                                                                                             Margin="0 0 5 0"/>
                                                                    <TextBlock Text="{Binding Tier}" 
                                                                               Foreground="#766839" 
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Code"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>

                                <Button Command="{Binding DataContext.AddCustomerCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="5 0 0 0">
                                    <Button.ToolTip>
                                        <ToolTip Content="Thêm khách hàng mới" 
                                                 Style="{StaticResource CustomTooltip}"
                                                 FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                    </Button.ToolTip>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <materialDesign:PackIcon x:Name="Icon"
                                                                                 Kind="PlusCircleOutline"
                                                                                 VerticalAlignment="Center"
                                                                                 Height="25" Width="25"
                                                                                 Foreground="#766839"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Icon" Property="Kind" Value="PlusCircle"/>
                                                                <Setter TargetName="Icon" Property="Foreground" Value="#C7A57A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>


                                <TextBlock Text="Khách hàng:" 
                                           VerticalAlignment="Center"
                                           Margin="10 0 0 0"
                                           FontFamily="Cascadia Code" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Foreground="#766839"/>

                                <TextBlock Text="{Binding SelectedCustomer.CustomerName, TargetNullValue='--'}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="180"
                                           Margin="5 0 0 0"
                                           FontFamily="Cascadia Code" 
                                           FontWeight="Bold" 
                                           FontSize="16" 
                                           Foreground="#340D05"/>
                            </StackPanel>

                            <!-- Order DataGrid -->
                            <Border BorderBrush="#766839" 
                                    BorderThickness="3"
                                    CornerRadius="15" 
                                    Margin="10"
                                    Background="#F9F6F0"
                                    Grid.Row="1">
                                <DataGrid x:Name="dtgListOrder"
                                          ItemsSource="{Binding Orders}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="#F9F6F0"
                                          FontFamily="Cascadia Code"
                                          FontSize="16"
                                          Margin="5"
                                          AlternationCount="1000000"
                                          EnableRowVirtualization="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F9F6F0"/>
                                            <Setter Property="Foreground" Value="#462812"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontFamily" Value="Cascadia Code"/>
                                            <Setter Property="FontSize" Value="15"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="BorderThickness" Value="0 0 1 1"/>
                                            <Setter Property="BorderBrush" Value="#766839"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#766839"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontFamily" Value="Cascadia Code"/>
                                            <Setter Property="Background" Value="#F9F6F0"/>
                                            <Setter Property="BorderBrush" Value="#A0A0A0"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="MinHeight" Value="40"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="STT" Width="0.4*" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="15">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                                                             Path="AlternationIndex" 
                                                                             Converter="{StaticResource IndexToNumberConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <Button Background="Transparent"
                                                                Cursor="Hand"
                                                                Padding="2"
                                                                Command="{Binding DataContext.RemoveItemCommand,
                                                                            RelativeSource={RelativeSource AncestorType=Page}}">
                                                            <Button.ToolTip>
                                                                <ToolTip Content="Xóa món" 
                                                                         Style="{StaticResource CustomTooltip}"
                                                                         FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                                            </Button.ToolTip>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <materialDesign:PackIcon x:Name="Icon"
                                                                                                         Kind="DeleteEmptyOutline"
                                                                                                         Foreground="#B18252"
                                                                                                         Width="20" Height="20"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Icon" Property="Kind" Value="Delete"/>
                                                                                        <Setter TargetName="Icon" Property="Foreground" Value="#C7A57A"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Tên sản phẩm" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Left" 
                                                                VerticalAlignment="Center"
                                                                Margin="5">
                                                        <TextBlock Text="{Binding ItemName}"
                                                                   FontWeight="Bold" 
                                                                   FontSize="15" 
                                                                   Foreground="#766839"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="130" Height="25" 
                                                                 VerticalAlignment="Center"
                                                                 FontFamily="Cascadia Code"
                                                                 FontSize="15" 
                                                                 Foreground="#C7A57A"
                                                                 materialDesign:HintAssist.Hint="Ghi chú"
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="#E0CEB5"
                                                                 KeyDown="tbItemOrderedNote_KeyDown"
                                                                 LostFocus="tbNote_LostFocus"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Size" Width="0.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeName}" 
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold" 
                                                               FontSize="15" 
                                                               Foreground="#766839"
                                                               Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Số lượng" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center" 
                                                          Margin="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Decrease Button -->
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Padding="2"
                                                                Margin="3 0"
                                                                Grid.Column="0"
                                                                Command="{Binding DataContext.DecreaseQuantityCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.ToolTip>
                                                                <ToolTip Content="Giảm số lượng" 
                                                                         Style="{StaticResource CustomTooltip}"
                                                                         FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                                            </Button.ToolTip>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <materialDesign:PackIcon x:Name="Icon"
                                                                                                         Kind="MinusCircleOutline"
                                                                                                         Foreground="#B18252"
                                                                                                         Width="20" Height="20"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Icon" Property="Kind" Value="MinusCircle"/>
                                                                                        <Setter TargetName="Icon" Property="Foreground" Value="#C7A57A"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Quantity TextBox -->
                                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Grid.Column="1"
                                                                 Width="25" Height="25"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalContentAlignment="Center"
                                                                 FontFamily="Cascadia Code"
                                                                 FontSize="15" 
                                                                 Foreground="#766839"
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="#766839">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter"
                                                                            Command="{Binding DataContext.CommitQuantityCommand,
                                                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                                            CommandParameter="{Binding}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>

                                                        <!-- Increase Button -->
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Padding="2"
                                                                Margin="3 0"
                                                                Grid.Column="2"
                                                                Command="{Binding DataContext.IncreaseQuantityCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.ToolTip>
                                                                <ToolTip Content="Tăng số lượng" 
                                                                         Style="{StaticResource CustomTooltip}"
                                                                         FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                                            </Button.ToolTip>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <materialDesign:PackIcon x:Name="Icon"
                                                                                                         Kind="PlusCircleOutline"
                                                                                                         Foreground="#B18252"
                                                                                                         Width="20" Height="20"
                                                                                                         HorizontalAlignment="Center"
                                                                                                         VerticalAlignment="Center"/>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Icon" Property="Kind" Value="PlusCircle"/>
                                                                                        <Setter TargetName="Icon" Property="Foreground" Value="#C7A57A"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Đơn giá" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold" 
                                                               FontSize="15" 
                                                               Foreground="#766839"
                                                               TextWrapping="Wrap"
                                                               Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Thành tiền" Width="1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                                               HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold" 
                                                               FontSize="15" 
                                                               Foreground="#766839"
                                                               Margin="4"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Total & Payment Section -->
                            <StackPanel Grid.Row="2" Margin="0 10 0 10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            Margin="0 0 20 5">
                                    <TextBlock Text="Tổng cộng: "
                                               FontSize="20" 
                                               FontFamily="Cascadia Code"
                                               Foreground="#462812"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} VND}"
                                               FontFamily="Cascadia Code" 
                                               FontSize="20" 
                                               Foreground="#340D05"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin=" 0 0 20 5">
                                    <TextBlock Text="Chọn mã giảm giá: "
                                               FontSize="20" 
                                               FontFamily="Cascadia Code"
                                               Foreground="#462812"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbDiscount"
                                              Width="200" Height="30"
                                              VerticalAlignment="Center"
                                              FontFamily="Cascadia Code"
                                              FontSize="15" 
                                              Foreground="#766839"
                                              ItemsSource="{Binding AvailableDiscounts}"
                                              SelectedItem="{Binding SelectedDiscount}"
                                              materialDesign:TextFieldAssist.UnderlineBrush="#766839">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DiscountCode}" 
                                                               FontWeight="Bold"
                                                               Margin="0 0 5 0"/>
                                                    <TextBlock Text=" - "/>
                                                    <TextBlock Text="{Binding DiscountName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            Margin="0 0 20 5">
                                    <TextBlock Text="Giảm giá: "
                                               FontSize="20" 
                                               FontFamily="Cascadia Code"
                                               Foreground="#462812"/>
                                    <TextBlock Text="{Binding FinalDiscount, StringFormat={}{0:N0} VND}"
                                               FontFamily="Cascadia Code" 
                                               FontSize="20" 
                                               Foreground="#340D05"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            Margin="0 0 20 10">
                                    <TextBlock Text="Thành tiền: "
                                               FontSize="25" 
                                               FontFamily="Cascadia Code" 
                                               FontWeight="Bold"
                                               Foreground="#462812"/>
                                    <TextBlock FontFamily="Cascadia Code" 
                                               FontSize="25" 
                                               FontWeight="Bold" 
                                               Foreground="#340D05"
                                               Text="{Binding FinalTotal, StringFormat={}{0:N0} VND}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0 0 20 0">
                                    <Border x:Name="bdrCancelOrder"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            Padding="10"
                                            CornerRadius="15"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            MouseEnter="border_MouseEnter"
                                            MouseLeave="border_MouseLeave">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding CancelOrderCommand}"
                                                          MouseAction="LeftClick" />
                                        </Border.InputBindings>
                                        <TextBlock Text="Hủy bỏ"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code"
                                                   Foreground="#766839"/>
                                    </Border>

                                    <Border x:Name="bdrPayOrder"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            Margin="30 0 0 0"
                                            Padding="10"
                                            CornerRadius="15"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            MouseEnter="border_MouseEnter"
                                            MouseLeave="border_MouseLeave">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding PayOrderCommand}" MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Thanh toán"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code"
                                                   Foreground="#766839"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Grid x:Name="LoadingOverlay" 
          Background="#AAEDE2D3" 
          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:Card UniformCornerRadius="50" Padding="20" Background="White">
                    <StackPanel>
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" 
                                 IsIndeterminate="True" 
                                 Width="60" Height="60"
                                 Foreground="#462812"/>
                        <TextBlock Text="Đang pha cà phê..." 
                               Margin="0,15,0,0" 
                               FontSize="16"
                               FontWeight="Bold"
                               FontFamily="Cascadia Code"
                               Foreground="#462812"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </Grid>
    </Grid>
</Page>