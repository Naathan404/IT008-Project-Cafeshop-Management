<Page x:Class="CoffeeShop.View.Staff.Staff_Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:CoffeeShop"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1100"
      MinHeight="0" MinWidth="1000"
      Title="Staff_Order">
    <Page.Resources>
        <!-- Style for Item card -->
        <Style x:Key="RoundedCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#E0CEB5" CornerRadius="15" ClipToBounds="True" MinWidth="130" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Margin="10"
                                       Grid.Row="0"
                                       Stretch="UniformToFill"
                                       Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       d:Source="/Assets/Images/imgItemExample.jpg"/>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 0 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Grid.Row="1"/>
                                <!--Item Size-->
                                <StackPanel x:Name="stpnItemSize" Orientation="Horizontal" Margin="0 0 10 0" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border x:Name="bdrItemSizeS"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            MouseDown="bdrItemSizeS_MouseDown">
                                        <TextBlock Text="S"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSizeM"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            Margin="2.5"
                                            MouseDown="bdrItemSizeM_MouseDown">
                                        <TextBlock Text="M"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSizeL"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            MouseDown="bdrItemSizeL_MouseDown">
                                        <TextBlock Text="L"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                </StackPanel>
                                <!--Item Price-->
                                <TextBlock x:Name="txtblItemPrice"
                                           Text="35.000đ"
                                           Grid.Row="3"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 0"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Style cho TabControl (xuống dòng khi không đủ độ rộng) -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Margin="0"
                              HorizontalAlignment="Stretch"/>
                            <!-- Tab content -->
                            <ContentPresenter Grid.Row="1"
                                      ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Border Background="#D4BA98"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border x:Name="bdrMenuTab"
                        Margin="15 15 10 15"
                        Background="#EDE2D3"
                        CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="-20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>
                        <TabControl x:Name="tabMain"
                                    Margin="10 10 10 0"
                                    materialDesign:ColorZoneAssist.Mode="Standard"
                                    Background="#C7A57A"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    materialDesign:ThemeAssist.Theme="Light">
                            <TabControl.ItemContainerStyle>
                                <!-- Style cho từng TabItem -->
                                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                    <Setter Property="Height" Value="50"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <!-- Font cho header -->
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="17" FontFamily="Cascadia Code" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabItem Header="Cà phê" FontSize="50">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Trà sữa">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Đá xay">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Trà">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Nước ép">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Sinh tố">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Food">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                    <UniformGrid>
                                        <!-- Nơi chứa các items -->
                                    </UniformGrid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Border x:Name="bdrOrderBox"
                        Margin="10 15 15 15"
                        Background="#EDE2D3"
                        CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="-20"
                                          Opacity="0.3"
                                          Color="Black"
                                          ShadowDepth="8"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableFurniture"
                                                         Margin="10 10 5 10"
                                                         Foreground="#766839"
                                                         Height="30" Width="30"/>
                                <ComboBox x:Name="cbTable"
                                          Width="90" Height="30"
                                          FontFamily="Cascadia Code" FontSize="15" Foreground="#340D05"
                                          materialDesign:HintAssist.HelperTextFontSize="20"
                                          materialDesign:HintAssist.ApplyHintPaddingBrush="True"
                                          ItemsSource="{Binding LongIntegerList}"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                          materialDesign:ListBoxItemAssist.SelectedFocusedBackground="#E0CEB5">
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
