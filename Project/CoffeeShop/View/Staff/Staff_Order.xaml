<Page x:Class="CoffeeShop.View.Staff.Staff_Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:CoffeeShop.View.Staff"
      xmlns:models="clr-namespace:CoffeeShop.Models"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1310"
      MinHeight="0" MinWidth="1000"
      Title="Staff_Order"
      Loaded="Page_Loaded">
    <Page.Resources>
        <local:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
        <!-- Style for Item card -->
        <Style x:Key="RoundedCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#E0CEB5" CornerRadius="15" 
                                ClipToBounds="True" 
                                MinWidth="130" MinHeight="150" 
                                MaxHeight="220" MaxWidth="200"
                                MouseDown="Item_MouseDown">
                            <StackPanel>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Margin="10" MaxHeight="80"
                                       Grid.Row="0"
                                       Stretch="UniformToFill"
                                       Source="{Binding ImagePath}"
                                       d:Source="/Assets/Images/imgItemExample.jpg"/>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding ItemName}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 10 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Grid.Row="1"
                                           TextWrapping="Wrap"/>
                                <!--Item Size-->
                                <StackPanel x:Name="stpnItemSize"
                                            Orientation="Horizontal" 
                                            Margin="0 0 10 0" Grid.Row="2" 
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Visibility="Collapsed"
                                            Loaded="ItemSize_Loaded">
                                    <Border x:Name="bdrItemSize0"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            MouseDown="bdrItemSize_MouseDown"
                                            MouseEnter="bdrItemSize_MouseEnter"
                                            MouseLeave="bdrItemSize_MouseLeave"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize0"
                                                   d:Text="S"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSize1"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            Margin="2.5"
                                            MouseDown="bdrItemSize_MouseDown"
                                            MouseEnter="bdrItemSize_MouseEnter"
                                            MouseLeave="bdrItemSize_MouseLeave"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize1"
                                                   d:Text="M"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSize2"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20"
                                            Height="20"
                                            MouseDown="bdrItemSize_MouseDown"
                                            MouseEnter="bdrItemSize_MouseEnter"
                                            MouseLeave="bdrItemSize_MouseLeave"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize2"
                                                   d:Text="L"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                </StackPanel>
                                <!--Item Price-->
                                <TextBlock x:Name="txtblItemPrice"
                                           Grid.Row="3"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 5"
                                           HorizontalAlignment="Right"
                                           Loaded="ItemPrice_Loaded"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Style cho TabControl (xuống dòng khi không đủ độ rộng) -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Margin="0"
                              HorizontalAlignment="Stretch"/>
                            <!-- Tab content -->
                            <ContentPresenter Grid.Row="1"
                                      ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border Background="#D4BA98"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border x:Name="bdrMenuTab"
                            Margin="10 10 10 15"
                            Background="#EDE2D3"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="-20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <TabControl x:Name="tabMain"
                                    Margin="10 10 10 0"
                                    materialDesign:ColorZoneAssist.Mode="Standard"
                                    Background="#C7A57A"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    materialDesign:ThemeAssist.Theme="Light">
                                <TabControl.ItemContainerStyle>
                                    <!-- Style cho từng TabItem -->
                                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                        <Setter Property="Height" Value="40"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="Padding" Value="7"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <!-- Font cho header -->
                                        <Setter Property="HeaderTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="15" FontFamily="Cascadia Code" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.ItemContainerStyle>

                                <TabItem x:Name="tabItemCategory1" Header="Cà phê">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory1">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory2" Header="Trà sữa">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory3" Header="Đá xay">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory3">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory4" Header="Trà">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory4">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory5" Header="Nước ép">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory5">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory6" Header="Sinh tố">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <!-- Binding items từ cơ sở dữ liệu -->
                                        <ItemsControl x:Name="icCategory6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem x:Name="tabItemCategory7" Header="Food">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="ItemsContainer_SizeChanged">
                                        <ItemsControl x:Name="icCategory7">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Item}">
                                                    <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}"
                                                                MouseDown="Item_MouseDown"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                            <StackPanel Orientation="Horizontal" 
                                        Height="50" Margin="0 0 10 10"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                <materialDesign:PackIcon x:Name="icSearchItem"
                                                         Kind="Magnify" 
                                                         Margin="450,20,0,0"
                                                         Width="20" Height="20"
                                                         Foreground="#766839"/>
                                <TextBox x:Name="txblSearchItem"
                                         Width="120" Height="40"
                                         materialDesign:HintAssist.Hint="Tìm kiếm"
                                         materialDesign:HintAssist.IsFloating="False"
                                         FontFamily="Cascadia Code"
                                         Foreground="#766839" FontSize="15" FontWeight="Bold"
                                         materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                         materialDesign:HintAssist.Foreground="#766839"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         TextChanged="txblSearchItem_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Border x:Name="bdrOrderBox"
                            Margin="5 10 15 15"
                            Background="#EDE2D3"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="-20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.2*"/>
                                <RowDefinition Height="2.5*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0 10 0 0" Grid.Row="0">
                                <ComboBox x:Name="cbTable"
                                          Width="90" Height="30" Margin="15 0 0 0"
                                          VerticalAlignment="Center"
                                          FontFamily="Cascadia Code" FontSize="15" Foreground="#766839"
                                          materialDesign:HintAssist.ApplyHintPaddingBrush="True"
                                          ItemsSource="{Binding LongIntegerList}"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                          materialDesign:ListBoxItemAssist.SelectedFocusedBackground="#E0CEB5"
                                          materialDesign:HintAssist.Hint="Chọn bàn"/>
                                <materialDesign:PackIcon x:Name="icSearchCustomer"
                                                         Kind="AccountSearchOutline"
                                                         Margin="30 0 0 0"
                                                         VerticalAlignment="Center"
                                                         Height="23" Width="23"
                                                         Foreground="#766839"
                                                         MouseDown="icSearchCustomer_MouseDown"
                                                         MouseEnter="icSearchCustomer_MouseEnter"
                                                         MouseLeave="icSearchCustomer_MouseLeave"/>
                                <TextBox x:Name="tbCustomerPhone"
                                         Width="100" Height="30" VerticalAlignment="Center"
                                         FontFamily="Cascadia Code" FontSize="15" Foreground="#340D05"
                                         materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                         TextChanged="tbCustomerPhone_TextChanged"/>
                                <!-- Popup hiển thị gợi ý -->
                                <Popup x:Name="popupCustomers"
                                       PlacementTarget="{Binding ElementName=tbCustomerPhone}"
                                       Placement="Bottom"
                                       Width="Auto"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border BorderBrush="#766839" 
                                            BorderThickness="2" 
                                            Background="#F9F6F0"
                                            CornerRadius="5"
                                            MaxHeight="250">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Customers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#D4BA98" 
                                                                BorderThickness="0 0 0 1"
                                                                Background="Transparent"
                                                                Cursor="Hand"
                                                                MouseDown="CustomerItem_MouseDown"
                                                                MouseEnter="CustomerItem_MouseEnter"
                                                                MouseLeave="CustomerItem_MouseLeave">
                                                            <StackPanel Margin="10 8">
                                                                <TextBlock Text="{Binding CustomerName}" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="14"
                                                                           FontFamily="Cascadia Code"
                                                                           Foreground="#766839"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                                                                    <materialDesign:PackIcon Kind="Phone" 
                                                                                             Width="14" Height="14" 
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#766839"
                                                                                             Margin="0 0 5 0"/>
                                                                    <TextBlock Text="{Binding PhoneNumber}" 
                                                                               Foreground="#766839" 
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Code"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                                                    <materialDesign:PackIcon Kind="Email" 
                                                                                             Width="14" Height="14" 
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="#766839"
                                                                                             Margin="0 0 5 0"/>
                                                                    <TextBlock Text="{Binding Email}" 
                                                                               Foreground="#766839" 
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Code"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <Border MouseEnter="icAddCustomer_MouseEnter"
                                        MouseLeave="icAddCustomer_MouseLeave"
                                        MouseDown="icAddCustomer_MouseDown">
                                    <materialDesign:PackIcon x:Name="icAddCustomer"
                                                             Kind="PlusCircleOutline"
                                                             VerticalAlignment="Center"
                                                             Height="20" Width="20"
                                                             Foreground="#766839"/>
                                </Border>
                                <TextBlock Text="Khách hàng:" 
                                           VerticalAlignment="Center"
                                           Margin="30 0 0 0"
                                           FontFamily="Cascadia Code" FontWeight="Bold" FontSize="17" Foreground="#766839"/>
                                <TextBlock x:Name="tblCustomerName"
                                           Text="Customer Name"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="WrapWithOverflow"
                                           MaxWidth="180"
                                           Margin="7 0 0 0"
                                           FontFamily="Cascadia Code" FontWeight="Bold" FontSize="17" Foreground="#340D05"/>
                            </StackPanel>
                            <Border BorderBrush="#766839" 
                                    BorderThickness="3"
                                    CornerRadius="15" 
                                    Margin="10 20 10 0"
                                    Background="#F9F6F0"
                                    Grid.Row="1">
                                <DataGrid x:Name="dtgListOrder"
                                          ItemsSource="{Binding Orders}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="#F9F6F0"
                                          FontFamily="Cascadia Code"
                                          FontSize="16"
                                          Margin="5"
                                          AlternationCount="1000000"
                                          EnableRowVirtualization="False">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F9F6F0"/>
                                            <Setter Property="Foreground" Value="#462812"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontFamily" Value="Cascadia Code"/>
                                            <Setter Property="FontSize" Value="18"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                            <Setter Property="BorderThickness" Value="0 0 1 1"/>
                                            <Setter Property="BorderBrush" Value="#766839"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#766839"/>
                                            <Setter Property="FontSize" Value="15"/>
                                            <Setter Property="FontFamily" Value="Cascadia Code"/>
                                            <Setter Property="Background" Value="#F9F6F0"/>
                                            <Setter Property="BorderBrush" Value="#A0A0A0"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="MinHeight" Value="40"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="STT" Width="0.4*" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontWeight="Bold" FontSize="15">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                                                             Path="AlternationIndex" 
                                                                             Converter="{StaticResource IndexToNumberConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                 Foreground="#BC9466"
                                                                                 Width="20" Height="20"
                                                                                 MouseDown="DeleteOrderItem_MouseDown"
                                                                                 Cursor="Hand"
                                                                                 MouseEnter="icDeleteItem_MouseEnter"
                                                                                 MouseLeave="icDeleteItem_MouseLeave"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Tên sản phẩm" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Left" 
                                                                VerticalAlignment="Center"
                                                                Margin="5">
                                                        <TextBlock Text="{Binding ItemName}"
                                                                   FontWeight="Bold" FontSize="15" Foreground="#766839"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBox x:Name="tbItemOrderedNote"
                                                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="130" Height="25" 
                                                                 VerticalAlignment="Center"
                                                                 FontFamily="Cascadia Code"
                                                                 FontSize="15" Foreground="#C7A57A"
                                                                 materialDesign:HintAssist.Hint="Ghi chú"
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="#E0CEB5"
                                                                 KeyDown="tbItemOrderedNote_KeyDown"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Size" Width="0.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeName}" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" FontSize="15" Foreground="#766839"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Số lượng" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" 
                                                                HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center" 
                                                                Margin="3">
                                                        <Border Background="Transparent"
                                                                Cursor="Hand"
                                                                Margin="5 5 5 0"
                                                                MouseDown="icMinusQuantity_MouseDown"
                                                                MouseEnter="bdrMinusQuantity_MouseEnter"
                                                                MouseLeave="bdrMinusQuantity_MouseLeave">
                                                            <materialDesign:PackIcon Kind="MinusCircleOutline"
                                                                                     Foreground="#B18252"
                                                                                     Width="20" Height="20"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBox x:Name="tbItemOrderedQuantity"
                                                                 Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="25" Height="25"
                                                                 VerticalAlignment="Center"
                                                                 FontFamily="Cascadia Code"
                                                                 FontSize="15" Foreground="#766839"
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                                                 KeyDown="tbItemOrderedQuantity_KeyDown"
                                                                 PreviewTextInput="tbItemOrderedQuantity_PreviewTextInput"/>
                                                        <Border Background="Transparent"
                                                                Cursor="Hand"
                                                                Margin="5 5 5 0"
                                                                MouseDown="icPlusQuantity_MouseDown"
                                                                MouseEnter="bdrPlusQuantity_MouseEnter"
                                                                MouseLeave="bdrPlusQuantity_MouseLeave">
                                                            <materialDesign:PackIcon Kind="PlusCircleOutline"
                                                                                     Foreground="#B18252"
                                                                                     Width="20" Height="20"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Đơn giá" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" FontSize="15" Foreground="#766839"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Thành tiền" Width="1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" FontSize="15" Foreground="#766839"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom"
                                            Margin="0 10 20 0">
                                    <TextBlock Text="Tổng cộng: "
                                               FontSize="20" FontFamily="Cascadia Code"
                                               Foreground="#462812"/>
                                    <TextBlock x:Name="tbTotalPrice"
                                               d:Text="10000000000 VND"
                                               FontFamily="Cascadia Code" FontSize="20" Foreground="#340D05"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom"
                                            Margin="0 10 20 0">
                                    <TextBlock Text="Giảm giá: "
                                               FontSize="20" FontFamily="Cascadia Code"
                                               Foreground="#462812"/>
                                    <TextBlock x:Name="tbTotalDiscount"
                                               d:Text="10000000000 VND"
                                               FontFamily="Cascadia Code" FontSize="20" Foreground="#340D05"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom"
                                            Margin="0 10 20 0">
                                    <TextBlock Text="Thành tiền: "
                                               FontSize="25" FontFamily="Cascadia Code" FontWeight="Bold"
                                               Foreground="#462812"/>
                                    <TextBlock x:Name="tbTotalAmount"
                                               d:Text="10000000000 VND"
                                               FontFamily="Cascadia Code" FontSize="25" FontWeight="Bold" Foreground="#340D05"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0 15 20 0">
                                    <Border x:Name="bdrCancelOrder"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            Padding="10"
                                            CornerRadius="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="Hủy bỏ"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrPayOrder"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            Margin="30 0 0 0"
                                            Padding="10"
                                            CornerRadius="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="Thanh toán"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code"
                                                   Foreground="#766839"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
