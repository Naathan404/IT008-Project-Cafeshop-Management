<Page x:Class="CoffeeShop.View.Staff.Staff_History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:CoffeeShop.View.Staff"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1110"
      Title="Staff_History"
      Background="#E0CEB5">
    <!--67582c C7A57A-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
        </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0"
                Text="LỊCH SỬ BÁN HÀNG"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontSize="50"
                FontWeight="ExtraBlack"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
>
            </TextBlock>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                BorderBrush="#BC9466"   
                BorderThickness="10"
                CornerRadius="5"
                Margin="40 0 40 20">

                <DataGrid x:Name="dgOrdersHistory"
                        ColumnHeaderStyle="{StaticResource dgHeaderStyle}"
                        AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserResizeColumns="False" CanUserReorderColumns="False"
                        HorizontalAlignment="Stretch"
                        GridLinesVisibility="None"
                        IsReadOnly="true">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hóa đơn" Width="3*" Binding="{Binding OrderID}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Tên khách hàng" Width="5*" Binding="{Binding CustomerName}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Tên nhân viên" Width="5*" Binding="{Binding EmployeeName}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Thời gian" Width="4*" Binding="{Binding OrderDate}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Tổng tiền" Width="4*" Binding="{Binding Total}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Hình thức" Width="4*" Binding="{Binding PaymentMethod}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="-10 0 40 0">
                
                <TextBox
                    Margin="0 0 0 0"
                    Height="50"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="Họ tên khách hàng"
                    materialDesign:HintAssist.Foreground="#462812"
                    materialDesign:HintAssist.Background="Transparent"
                    materialDesign:TextFieldAssist.UnderlineBrush="#462812"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                    BorderThickness="1"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                />

                    <!-- TIME FILTER-->
                <Grid Height="90"
                      Margin="0 10 0 0"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"></RowDefinition>
                        <RowDefinition Height="7*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Thời gian:"
                               Foreground="#FF340D05"
                               FontFamily="Cascadia Code"
                               FontSize="20"
                               FontWeight="Bold"></TextBlock>
                    <Grid
                        Grid.Row="1"
                        Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <materialDesign:TimePicker
                            Grid.Column="0"
                            Height="48"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.Hint="Từ..."
                            materialDesign:HintAssist.Foreground="#462812"
                            materialDesign:HintAssist.Background="Transparent"
                            materialDesign:TextFieldAssist.UnderlineBrush="#462812"                            
                            materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                            BorderThickness="1"
                            Is24Hours="True"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                              />
                        <TextBlock Grid.Column ="1"
                                   Text=" _ "
                                   FontSize="10"
                                   FontFamily="Cascadia Code"
                                   VerticalAlignment="Center"
                                   Foreground="#FF340D05"></TextBlock>
                        <materialDesign:TimePicker
                            Grid.Column="2"
                            Height="48"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.Hint="Đến..."
                            materialDesign:HintAssist.Foreground="#462812"
                            materialDesign:HintAssist.Background="Transparent"
                            materialDesign:TextFieldAssist.UnderlineBrush="#462812"                            
                            materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                            BorderThickness="1"
                            Is24Hours="True"
                            Style="{StaticResource MaterialDesignOutlinedTimePicker}"
                              />
                    </Grid>
                </Grid>

                <!-- TOTAL FILTER
                <Grid Height="130"
                      Margin="0 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"></RowDefinition>
                        <RowDefinition Height="7*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tổng tiền:"
                               FontFamily="Cascadia Code"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Top"></TextBlock>
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Orientation="Vertical" 
                        Margin="0,5,0,0">

                    </StackPanel>
                </Grid> -->

                <Button
                    materialDesign:ButtonAssist.CornerRadius="10"
                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Background="#BC9466"
                    Height="50"
                    Margin="0 20 0 0"
                    BorderBrush="#FF340D05"
                    BorderThickness="1">
                    <TextBlock Text="In hóa đơn" 
                               FontFamily="Cascadia Code"
                               FontWeight="Bold"
                               FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
