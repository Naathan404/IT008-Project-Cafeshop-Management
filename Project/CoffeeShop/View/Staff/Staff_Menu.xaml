<Page x:Class="CoffeeShop.View.Staff.Staff_Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop.View.Staff"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:CoffeeShop.ViewModels.StaffVM"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1310"
      Title="Staff_Menu">
    <Page.Resources>
        <local:ObjectEqualsConverter x:Key="ObjectEqualsConverter"/>
        <!-- Style for Item card -->
        <Style x:Key="RoundedCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="BorderContainer"
                                Background="#E0CEB5" CornerRadius="15"
                                MinWidth="130" MinHeight="150" 
                                MaxHeight="220" MaxWidth="200"
                                MouseDown="Item_MouseDown"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><!-- Ảnh -->
                                    <RowDefinition Height="Auto"/><!-- Tên -->
                                    <RowDefinition Height="*"/><!-- EMPTY SPACE -->
                                    <RowDefinition Height="Auto"/><!-- Size -->
                                    <RowDefinition Height="Auto"/><!-- Giá -->
                                </Grid.RowDefinitions>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Grid.Row="0"
                                       Margin="10" MaxHeight="80"
                                       Stretch="UniformToFill"
                                       Source="{Binding ImagePath}"
                                       d:Source="/Assets/Images/imgItemExample.jpg"/>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding ItemName}"
                                           Grid.Row="1"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 10 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Grid Grid.Row="2"></Grid>
                                <!--Item Size-->
                                <StackPanel x:Name="stpnItemSize"
                                            Orientation="Horizontal" 
                                            Margin="0 5 10 0"
                                            Grid.Row="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Loaded="ItemSize_Loaded">
                                    <Border x:Name="bdrItemSize0"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20" Height="20"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize0"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSize1"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20" Height="20"
                                            Margin="2.5 0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize1"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                    <Border x:Name="bdrItemSize2"
                                            BorderBrush="#766839"
                                            BorderThickness="2"
                                            CornerRadius="15"
                                            Width="20" Height="20"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="txtSize2"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Bahnschrift"
                                                   Foreground="#766839"/>
                                    </Border>
                                </StackPanel>
                                <!--Item Price-->
                                <TextBlock x:Name="txtblItemPrice"
                                           Grid.Row="4"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 5"
                                           HorizontalAlignment="Right"
                                           Loaded="ItemPrice_Loaded"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#340D05" 
                                                          Direction="315" 
                                                          ShadowDepth="3" 
                                                          BlurRadius="10" 
                                                          Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Item bị tắt -->
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="BorderContainer"
                                        Property="Opacity"
                                        Value="0.2"/>
                            </DataTrigger>

                            <!-- Item đang được chọn -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ObjectEqualsConverter}">
                                        <!-- SelectedItem -->
                                        <Binding Path="DataContext.SelectedItem"
                                                 RelativeSource="{RelativeSource AncestorType=Page}"/>
                                        <!-- Item hiện tại -->
                                        <Binding/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#340D05"
                                                          Direction="315" 
                                                          ShadowDepth="6"
                                                          Opacity="0.35" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Style cho TabControl (xuống dòng khi không đủ độ rộng) -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0"
                                      HorizontalAlignment="Stretch"/>
                            <!-- Tab content -->
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#D4BA98">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Panel -->
        <Grid Grid.Column="0">
            <Border x:Name="bdrMenuTab"
                    Margin="10 10 10 15"
                    Background="#EDE2D3"
                    CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Opacity="0.3"
                                      Color="Black"
                                      ShadowDepth="8"/>
                </Border.Effect>
                <Grid>
                    <TabControl x:Name="tabMain"
                                Margin="10 10 10 0"
                                materialDesign:ColorZoneAssist.Mode="Standard"
                                Background="#C7A57A"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Stretch"
                                materialDesign:ThemeAssist.Theme="Light"
                                SelectionChanged="TabControl_SelectionChanged">
                        <TabControl.ItemContainerStyle>
                            <!-- Style cho từng TabItem -->
                            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Font cho header -->
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       FontSize="15" 
                                                       FontFamily="Cascadia Code" 
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- Tab Tất cả các món -->
                        <TabItem Header="Tất cả" Tag="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Cà phê - CategoryId = 1 -->
                        <TabItem Header="Cà phê" Tag="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Trà sữa - CategoryId = 2 -->
                        <TabItem Header="Trà sữa" Tag="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Đá xay - CategoryId = 3 -->
                        <TabItem Header="Đá xay" Tag="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Trà - CategoryId = 4 -->
                        <TabItem Header="Trà" Tag="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Nước ép - CategoryId = 5 -->
                        <TabItem Header="Nước ép" Tag="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Sinh tố - CategoryId = 6 -->
                        <TabItem Header="Sinh tố" Tag="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Food - CategoryId = 7 -->
                        <TabItem Header="Food" Tag="7">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  SizeChanged="ItemsContainer_SizeChanged">
                                <ItemsControl ItemsSource="{Binding FilteredItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource RoundedCard}"
                                                            Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Search Box -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0 0 15 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Magnify"
                                                 Margin="450,20,0,10"
                                                 Width="20" Height="20"
                                                 Foreground="#766839"/>
                        <TextBox x:Name="txblSearchItem"
                                 Grid.Column="1"
                                 Text="{Binding SearchItemKeyword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Height="40" MinWidth="120"
                                 materialDesign:HintAssist.Hint="Tìm kiếm"
                                 materialDesign:HintAssist.IsFloating="False"
                                 FontFamily="Cascadia Code"
                                 Foreground="#766839" 
                                 FontSize="15" 
                                 FontWeight="Bold"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#766839"
                                 materialDesign:HintAssist.Foreground="#766839"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Order Panel -->
        <Grid Grid.Column="1">
            <Border x:Name="bdrItemDetail"
                    Margin="5 10 15 15"
                    Background="#EDE2D3"
                    CornerRadius="15"
                    DataContext="{Binding SelectedItem}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Opacity="0.3"
                                      Color="Black"
                                      ShadowDepth="8"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>
                    
                    <!--Item Image-->
                    <Grid Grid.Row="0" Margin="20">
                        <Border Width="Auto">
                            <Image x:Name="imgItem"
                                   Stretch="UniformToFill"
                                   Source="{Binding ImagePath}"
                                   d:Source="/Assets/Images/imgItemExample.jpg"/>
                        </Border>
                    </Grid>
                    
                    <!-- Item Name & Size-->
                    <StackPanel Grid.Row="1" Margin="5">
                        <!--Item Name-->
                        <TextBlock Text="{Binding ItemName}"
                                   d:Text="Cà phê sữa"
                                   Margin="20 0 0 0"
                                   FontSize="45"
                                   FontFamily="Cascadia Code"
                                   FontWeight="Bold"
                                   Foreground="#766839"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <!--Item Size-->
                        <StackPanel x:Name="stpnItemSize" 
                                    Orientation="Horizontal"
                                    Margin="20 20 20 0"
                                    VerticalAlignment="Top"
                                    d:Visibility="Visible"
                                    Visibility="Collapsed"
                                    Loaded="ItemSize_Loaded">
                            <TextBlock Text="Size:"
                                       Foreground="#766839"
                                       FontSize="30" 
                                       FontFamily="Cascadia Code" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="bdrItemSize0"
                                    BorderBrush="#766839"
                                    BorderThickness="2.5"
                                    CornerRadius="20"
                                    Width="40"
                                    Height="40"
                                    Margin="10 0 0 0"
                                    d:Visibility="Visible"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtSize0"
                                           Text="S"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Bahnschrift"
                                           Foreground="#766839"/>
                            </Border>
                            <Border x:Name="bdrItemSize1"
                                    BorderBrush="#766839"
                                    BorderThickness="2"
                                    CornerRadius="20"
                                    Width="40"
                                    Height="40"
                                    Margin="5 0 5 0"
                                    d:Visibility="Visible"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtSize1"
                                           Text="M"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Bahnschrift"
                                           Foreground="#766839"/>
                            </Border>
                            <Border x:Name="bdrItemSize2"
                                    BorderBrush="#766839"
                                    BorderThickness="2"
                                    CornerRadius="20"
                                    Width="40"
                                    Height="40"
                                    d:Visibility="Visible"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtSize2"
                                           Text="L"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Bahnschrift"
                                           Foreground="#766839"/>
                            </Border>
                        </StackPanel>

                        <!--Item Price-->
                        <StackPanel x:Name="stpnItemPrice" 
                                    Orientation="Horizontal" 
                                    Margin="20 20 0 0">
                            <TextBlock Text="Giá:"
                                       Foreground="#766839"
                                       FontSize="30" 
                                       FontFamily="Cascadia Code"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txblItemPrice"
                                       Text="{Binding ItemPrice, StringFormat={}{0:N0} VND}"
                                       d:Text="45000 VND"
                                       Foreground="#766839"
                                       FontSize="35" FontFamily="Cascadia Code"
                                       Margin="15 0 0 0"
                                       Loaded="ItemPrice_Loaded"/>
                        </StackPanel>
                    </StackPanel>

                    <!--Buttons-->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="15">
                        <Border x:Name="bdrSetIsAvailable"
                                BorderBrush="#766839"
                                BorderThickness="2"
                                Margin="30 0 0 0"
                                Padding="10"
                                CornerRadius="15"
                                Cursor="Hand"
                                Background="Transparent"
                                MouseEnter="border_MouseEnter"
                                MouseLeave="border_MouseLeave">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding DataContext.SetIsAvailableForItem,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"
                                              MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <TextBlock Text="{Binding DataContext.TextButtonSetAvailable,
                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                       d:Text="Tắt món"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Cascadia Code"
                                       Foreground="#766839"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
