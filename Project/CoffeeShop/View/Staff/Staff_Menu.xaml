<Page x:Class="CoffeeShop.View.Staff.Staff_Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop.View.Staff"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:CoffeeShop.ViewModels.StaffVM"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1310"
      Title="Staff_Menu"
      Background="#E0CEB5">
    <Page.Resources>
        <local:ObjectEqualsConverter x:Key="ObjectEqualsConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:GreaterThanOneConverter x:Key="GreaterThanOneConverter"/>

        <!-- Style for Item card -->
        <Style x:Key="RoundedCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="BorderContainer"
                                Background="#E0CEB5" CornerRadius="15"
                                MinWidth="130" MinHeight="150" 
                                MaxHeight="220" MaxWidth="200"
                                MouseDown="Item_MouseDown"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Ảnh -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Tên -->
                                    <RowDefinition Height="*"/>
                                    <!-- EMPTY SPACE -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Size -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Giá -->
                                </Grid.RowDefinitions>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Grid.Row="0"
                                       Margin="10" MaxHeight="80"
                                       Stretch="UniformToFill"
                                       Source="{Binding ImagePath}"
                                       d:Source="/Assets/Images/imgItemExample.jpg"/>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding ItemName}"
                                           Grid.Row="1"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 10 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Grid Grid.Row="2"></Grid>
                                <!--Item Size - Hiển thị sizes bằng ItemsControl-->
                                <ItemsControl Grid.Row="3"
                                                  ItemsSource="{Binding ItemPrices}"
                                                  Margin="0 5 10 0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemPrices.Count}" Value="1"/>
                                                        <Condition Binding="{Binding CategoryId}" Value="7"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#766839"
                                                    BorderThickness="2"
                                                    CornerRadius="15"
                                                    Width="20" Height="20"
                                                    Margin="0 0 2.5 0">
                                                <TextBlock Text="{Binding Size.SizeName}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Bahnschrift"
                                                           Foreground="#766839"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--Item Price - Hiển thị giá đầu tiên-->
                                <TextBlock Grid.Row="4"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 5"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:N0} VND">
                                            <Binding Path="ItemPrices[0].Price"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#340D05" 
                                                          Direction="315" 
                                                          ShadowDepth="3" 
                                                          BlurRadius="10" 
                                                          Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Item bị tắt -->
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="BorderContainer"
                                        Property="Opacity"
                                        Value="0.2"/>
                            </DataTrigger>

                            <!-- Item đang được chọn -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ObjectEqualsConverter}">
                                        <!-- SelectedItem -->
                                        <Binding Path="DataContext.SelectedItem"
                                                 RelativeSource="{RelativeSource AncestorType=Page}"/>
                                        <!-- Item hiện tại -->
                                        <Binding/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black"
                                                          Direction="315"
                                                          ShadowDepth="7"
                                                          Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BorderContainer" Property="Background" Value="#D5BCA1"/>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Style cho TabControl (xuống dòng khi không đủ độ rộng) -->
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab headers -->
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0"
                                      HorizontalAlignment="Stretch"/>
                            <!-- Tab content -->
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="TRẠNG THÁI MÓN ĂN" 
                       Grid.Row="0" Margin="30,10,0,10"
                       FontSize="24" FontWeight="ExtraBlack" Foreground="#4E342E"
                       FontFamily="Cascadia Code"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Menu Panel -->
                <Grid Grid.Column="0">
                    <Border x:Name="bdrMenuTab"
                            Margin="30 0 10 15"
                            Background="#F9F6F0"
                            CornerRadius="15"
                            BorderThickness="2"
                            BorderBrush="#766839">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                      Opacity="0.3"
                                      Color="Black"
                                      ShadowDepth="8"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="10 5 10 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                        Background="White" 
                                        CornerRadius="20"
                                        BorderBrush="#BC9466"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                    <Grid Margin="15 5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Magnify" 
                                                                 Foreground="#462812" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="0,0,10,0"/>
                                        <TextBox x:Name="txblSearchItem"
                                                 Grid.Column="1"
                                                 Text="{Binding SearchItemKeyword, 
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Foreground="#462812"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 materialDesign:HintAssist.Hint="Tìm kiếm tên món..."
                                                 materialDesign:HintAssist.FontFamily="Cascadia Code"
                                                 Style="{StaticResource MaterialDesignTextBox}"/>
                                    </Grid>
                                </Border>

                                <TabControl x:Name="tabMain"
                                            Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            SelectedItem="{Binding SelectedTabItem}">

                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                            <Setter Property="Height" Value="45"/>
                                            <Setter Property="Padding" Value="7"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" 
                                                               FontSize="15"
                                                               FontFamily="Cascadia Code" 
                                                               FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.ItemContainerStyle>

                                    <TabItem Header="Tất cả" Tag="0"/>
                                    <TabItem Header="Cà phê" Tag="1"/>
                                    <TabItem Header="Trà sữa" Tag="2"/>
                                    <TabItem Header="Đá xay" Tag="3"/>
                                    <TabItem Header="Trà" Tag="4"/>
                                    <TabItem Header="Nước ép" Tag="5"/>
                                    <TabItem Header="Sinh tố" Tag="6"/>
                                    <TabItem Header="Food" Tag="7"/>
                                </TabControl>
                            </Grid>
                            <Border Grid.Row="1" Margin="10 0 10 10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              HorizontalContentAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding FilteredItems}"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  HorizontalAlignment="Stretch"
                                                  SizeChanged="ItemsContainer_SizeChanged">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid VerticalAlignment="Top" 
                                                             HorizontalAlignment="Left"
                                                             Width="Auto"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource RoundedCard}" 
                                                                Content="{Binding}" Margin="5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Item Detaited Panel -->
                <Grid Grid.Column="1">
                    <Border x:Name="bdrItemDetail"
                            Margin="5 0 30 15"
                            Background="#F9F6F0"
                            CornerRadius="15"
                            DataContext="{Binding SelectedItem}"
                            BorderBrush="#766839"
                            BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              Opacity="0.3"
                                              Color="Black"
                                              ShadowDepth="8"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1.5*"/>
                                <RowDefinition Height="0.5*"/>
                            </Grid.RowDefinitions>

                            <!-- Hiển thị khi chưa chọn item -->
                            <TextBlock Text="Vui lòng chọn item"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       FontFamily="Cascadia Code"
                                       Foreground="#766839"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--Item Image-->
                            <Grid Grid.Row="0" Margin="20">
                                <Border Width="Auto">
                                    <Image x:Name="imgItem"
                                           Stretch="UniformToFill"
                                           Source="{Binding ImagePath}"
                                           d:Source="/Assets/Images/imgItemExample.jpg"/>
                                </Border>
                            </Grid>

                            <!-- Item Name & Size-->
                            <StackPanel Grid.Row="1" Margin="5">
                                <!--Item Name-->
                                <TextBlock Text="{Binding ItemName}"
                                           d:Text="Cà phê sữa"
                                           Margin="20 0 0 0"
                                           FontSize="35"
                                           FontFamily="Cascadia Code"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <!--Item Size - Bind với ViewModel-->
                                <StackPanel Orientation="Horizontal"
                                            Margin="20 10 20 0"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding DataContext.AvailableSizes.Count, 
                                                        RelativeSource={RelativeSource AncestorType=Page},
                                                        Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="Size:"
                                               Foreground="#766839"
                                               FontSize="25" 
                                               FontFamily="Cascadia Code" 
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <!-- ItemsControl để hiển thị các size -->
                                    <ItemsControl ItemsSource="{Binding DataContext.AvailableSizes, 
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                                  Margin="10 0 0 0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#766839"
                                                        BorderThickness="2.5"
                                                        CornerRadius="20"
                                                        Width="35"
                                                        Height="35"
                                                        Margin="0 0 5 0"
                                                        Cursor="Hand">
                                                    <Border.ToolTip>
                                                        <ToolTip Content="Xóa món" Style="{StaticResource CustomTooltip}"/>
                                                    </Border.ToolTip>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <!-- Hover effect -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="#D4BA98"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <!-- Selected state -->
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="#766839"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Border.InputBindings>
                                                        <MouseBinding Command="{Binding DataContext.SelectSizeCommand,
                                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}"
                                                                        MouseAction="LeftClick"/>
                                                    </Border.InputBindings>

                                                    <TextBlock Text="{Binding SizeName}"
                                                                FontSize="25"
                                                                FontWeight="Bold"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Bahnschrift">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#766839"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#EDE2D3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!--Item Price-->
                                <StackPanel x:Name="stpnItemPrice" 
                                            Orientation="Horizontal" 
                                            Margin="20 10 0 0">
                                    <TextBlock Text="Giá:"
                                               Foreground="#766839"
                                               FontSize="25" 
                                               FontFamily="Cascadia Code"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txblItemPrice"
                                               Text="{Binding DataContext.SelectedPriceFormatted,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                               d:Text="45000 VND"
                                               Foreground="#766839"
                                               FontSize="30" FontFamily="Cascadia Code"
                                               Margin="15 0 0 0"/>
                                </StackPanel>

                                <Grid x:Name="stpnInfo"
                                      Margin="20 25 10 0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="80"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Mô tả:"
                                               Grid.Row="0"
                                               Foreground="#766839"
                                               FontSize="18" FontFamily="Cascadia Code"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="140"
                                                  MaxWidth="430"
                                                  Grid.Row="1"
                                                  Margin="0 10 0 0"
                                                  VerticalAlignment="Top"
                                                  HorizontalAlignment="Left">
                                        <TextBlock x:Name="txblItemInfo"
                                                   Text="{Binding Info}"
                                                   FontFamily="Cascadia Code"
                                                   Foreground="#766839" 
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Justify"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Stretch"/>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!--Buttons-->
                            <StackPanel Grid.Row="2" 
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="15">
                                <Border x:Name="bdrSetIsAvailable"
                                        BorderBrush="#766839"
                                        BorderThickness="2"
                                        Margin="30 0 0 0"
                                        Padding="10"
                                        CornerRadius="15"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        MouseEnter="border_MouseEnter"
                                        MouseLeave="border_MouseLeave">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.SetIsAvailableForItem,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"
                                                      MouseAction="LeftClick"/>
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding DataContext.TextButtonSetAvailable,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                               d:Text="Tắt món"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Code"
                                               Foreground="#766839"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="2"
              Background="#AAEDE2D3" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 Value="0" 
                                 IsIndeterminate="True" 
                                 Width="60" Height="60"
                                 Foreground="#462812"/>
                    <TextBlock Text="Đang pha cà phê..." 
                               Margin="0,15,0,0" 
                               FontSize="16"
                               FontWeight="Bold"
                               FontFamily="Cascadia Code"
                               Foreground="#462812"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
