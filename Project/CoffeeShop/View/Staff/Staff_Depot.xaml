<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="CoffeeShop.View.Staff.Staff_Depot"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Staff_Depot">

    <Grid Background="#E0CEB5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="25">
            <DockPanel Height="43">
                <!-- Filter -->
                <Border 
                    Background="#B18252"
                    Width="90" Margin="5" CornerRadius="5">
                    <Grid>
                        <Button x:Name="btnFilter"
                            Content="Bộ lọc" FontFamily="Times New Roman"
                            Click="btnPopup_Click"
                            BorderBrush="Transparent" Background="#B18252">
                        </Button>

                        <Popup x:Name="popupFilter"
                            Width="250" Height="Auto" PlacementTarget="{Binding ElementName=PopupButton}" 
                            Placement="Bottom" 
                            AllowsTransparency="True"
                            StaysOpen="False"
                            Margin="5">
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="15">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Lọc theo Số lượng" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Từ:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="txbMin1" Grid.Column="1" Margin="0,0,10,0" Width="Auto"/>

                                            <TextBlock Text="Đến:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="txbMax1" Grid.Column="3" Width="Auto"/>
                                        </Grid>
                                    </StackPanel>

                                    <Separator Margin="0,5"/>

                                    <Button Content="Áp dụng" Margin="0,15,0,0" Padding="5"
                                        BorderBrush="Transparent" Background="#B18252"
                                        Click="btnApplyFilter_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    
                </Border>

                <!-- Search button -->
                <Border 
                    Background="#B18252"
                    Margin="5" CornerRadius="5"
                    DockPanel.Dock="Right">
                    <Button 
                        x:Name="btnSearch"
                        Content="Tìm kiếm" FontFamily="Times New Roman"
                        Background="#B18252" BorderBrush="Transparent"
                        Click="btnSearch_Click"/>
                </Border>
                
                <!-- Search bar -->
                <Border 
                    Background="LightGray"
                    Margin="5" CornerRadius="5"
                    Padding="10,0,0,0"
                    KeyDown="txbSearch_KeyDown">
                    <TextBox x:Name="txbSearch" 
                        Foreground="Black">
                    </TextBox>
                </Border>
            </DockPanel>

            <!-- Datagrid - The place that contains the items in dopet -->
            <DataGrid x:Name="dgDepot"
                ColumnHeaderStyle="{StaticResource dgTemplate}"
                Grid.Row="1" Margin="5"
                AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserResizeColumns="False" CanUserReorderColumns="False"
                HorizontalAlignment="Stretch" Height="440"
                GridLinesVisibility="None"
                IsReadOnly="true">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="0.6*"/>
                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*"/>
                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="0.7*"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Function button -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="btnReport" 
                    Content="BÁO CÁO"
                    Grid.Row="0"
                    Style="{StaticResource depotButtonStyle}"/>

                <Button x:Name="btnUpdate" 
                    Content="CẬP NHẬT"
                    Grid.Row="1"
                    Style="{StaticResource depotButtonStyle}"/>

                <Button x:Name="btnAdd" 
                    Content="THÊM"
                    Grid.Row="2"
                    Style="{StaticResource depotButtonStyle}"/>
            </Grid>

            <Button x:Name="btnHistory"
                Grid.Row="1"
                Content="LỊCH SỬ"
                VerticalAlignment="Center"
                Style="{StaticResource depotButtonStyle}"/>
        </Grid>
    </Grid>
</Page>