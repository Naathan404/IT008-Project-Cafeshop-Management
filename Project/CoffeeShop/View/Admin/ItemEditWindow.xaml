<Window x:Class="CoffeeShop.View.Admin.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop.View.Admin"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ItemEditWindow" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#C7A57A" 
                Padding="10">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Cascadia Code"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Info & Image -->
            <Grid Grid.Column="0" Margin="0 0 10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Image Section -->
                <GroupBox Header="Hình ảnh món" 
                          FontSize="16" 
                          FontWeight="Bold"
                          FontFamily="Cascadia Code"
                          Foreground="#766839"
                          Margin="0 0 0 10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Image Preview -->
                        <Border Grid.Row="0"
                                Width="250" 
                                Height="180"
                                BorderBrush="#766839"
                                BorderThickness="2"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                Margin="10">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" 
                                            Stretch="UniformToFill" 
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>

                        <!-- Upload Button -->
                        <Button Grid.Row="1"
                                Content="Chọn ảnh"
                                Command="{Binding UploadImageCommand}"
                                Width="120"
                                Height="35"
                                FontSize="14"
                                FontWeight="Bold"
                                Margin="10"
                                HorizontalAlignment="Center"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#766839"
                                Foreground="White"/>
                    </Grid>
                </GroupBox>

                <!-- Info Section -->
                <GroupBox Header="Thông tin cơ bản" 
                          Grid.Row="1"
                          FontSize="16" 
                          FontWeight="Bold"
                          FontFamily="Cascadia Code"
                          Foreground="#766839">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <!-- Item Name -->
                            <TextBlock Text="Tên món:"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="Cascadia Code"
                                       Foreground="#766839"
                                       Margin="0 5"/>
                            <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14"
                                     Padding="8"
                                     FontFamily="Cascadia Code"
                                     materialDesign:HintAssist.Hint="Nhập tên món"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Category -->
                            <TextBlock Text="Danh mục:"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="Cascadia Code"
                                       Foreground="#766839"
                                       Margin="0 10 0 5"/>
                            <ComboBox SelectedValue="{Binding CategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Categories}"
                                      FontSize="14"
                                      FontFamily="Cascadia Code"
                                      Padding="8"
                                      materialDesign:HintAssist.Hint="Chọn danh mục"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <!-- Description -->
                            <TextBlock Text="Mô tả:"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       FontFamily="Cascadia Code"
                                       Foreground="#766839"
                                       Margin="0 5"/>
                            <TextBox Text="{Binding Info, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     FontFamily="Cascadia Code"
                                     Padding="8"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Hint="Nhập mô tả món"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- Right Column: Sizes & Prices -->
            <GroupBox Grid.Column="1" 
                      Header="Kích cỡ và giá" 
                      FontFamily="Cascadia Code"
                      FontSize="16" 
                      FontWeight="Bold"
                      Foreground="#766839"
                      Margin="10 0 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="119*"/>
                        <ColumnDefinition Width="246*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Size Button -->
                    <Button Grid.Row="0"
                            Content="+ Thêm size"
                            Command="{Binding AddSizeCommand}"
                            Width="120"
                            Height="32"
                            FontSize="13"
                            FontWeight="Bold"
                            FontFamily="Cascadia Code"
                            HorizontalAlignment="Center"
                            Margin="5,5,0,5"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#C7A57A"
                            Foreground="White"/>

                    <!-- Sizes List -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="10 0 10 10" Grid.ColumnSpan="2">
                        <ItemsControl ItemsSource="{Binding SizePrices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="12"
                                            Margin="0 5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Size - Ẩn nếu là Food -->
                                            <StackPanel Grid.Row="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CategoryId, RelativeSource={RelativeSource AncestorType=Window}}" Value="7">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="Size:"
                                                           FontSize="13"
                                                           FontFamily="Cascadia Code"
                                                           Foreground="#766839"
                                                           Margin="0 0 0 5"/>
                                                <ComboBox SelectedValue="{Binding SizeId}"
                                                          SelectedValuePath="SizeId"
                                                          DisplayMemberPath="SizeName"
                                                          ItemsSource="{Binding DataContext.AvailableSizes,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                          FontSize="13"
                                                          FontFamily="Cascadia Code"
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                            </StackPanel>

                                            <!-- Price -->
                                            <StackPanel Grid.Row="1">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Margin" Value="0 10 0 0"/>
                                                        <Style.Triggers>
                                                            <!-- Nếu là Food thì không có margin top vì không có Size combobox -->
                                                            <DataTrigger Binding="{Binding DataContext.CategoryId, RelativeSource={RelativeSource AncestorType=Window}}" Value="7">
                                                                <Setter Property="Margin" Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="Giá (VND):"
                                                           FontSize="13"
                                                           FontFamily="Cascadia Code"
                                                           Foreground="#766839"
                                                           Margin="0 0 0 5"/>
                                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"
                                                         FontFamily="Cascadia Code"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>

                                            <!-- Delete Button -->
                                            <Button Grid.Row="2"
                                                    Content="Xóa"
                                                    Command="{Binding DataContext.RemoveSizeCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="80"
                                                    Height="30"
                                                    FontSize="12"
                                                    FontFamily="Cascadia Code"
                                                    Margin="0 10 0 0"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#766839"
                                                    Foreground="White"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="2" 
                Background="#E8E8E8" 
                Padding="15"
                BorderBrush="#CCCCCC"
                BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Lưu"
                        Command="{Binding SaveCommand}"
                        Width="90"
                        Height="40"
                        FontSize="15"
                        FontWeight="Bold"
                        FontFamily="Cascadia Code"
                        Margin="0 0 10 0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C7A57A"
                        Foreground="White"/>

                <Button Content="Hủy"
                        Command="{Binding CancelCommand}"
                        Width="90"
                        Height="40"
                        FontSize="15"
                        FontFamily="Cascadia Code"
                        FontWeight="Bold"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C7A57A"
                        Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="9999">

            <Border Background="#80000000" />

            <Border Width="280" 
                    Height="130"
                    Background="White"
                    CornerRadius="15"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                                      ShadowDepth="5" 
                                      Opacity="0.4"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="180"
                                 Height="6"
                                 Margin="0 0 0 15"
                                 Foreground="#4A90E2"/>

                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>