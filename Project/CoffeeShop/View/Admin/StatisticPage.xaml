<Page x:Class="CoffeeShop.View.Admin.StatisticPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:local="clr-namespace:CoffeeShop.View.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1110"
      Background="#E0CEB5"
      Title="Thống kê cửa hàng">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
            <DatePicker x:Name="dpStartDate" Width="120" 
                    materialDesign:HintAssist.Hint="Từ ngày"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

            <TextBlock Text="-" VerticalAlignment="Center" Margin="10,0"/>

            <DatePicker x:Name="dpEndDate" Width="120" 
                    materialDesign:HintAssist.Hint="Đến ngày"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

            <Button Content="Thống kê" Margin="20,0,0,0"
                Background="#391B05" BorderBrush="#391B05"/>

            <materialDesign:Card Margin="50,0,0,0" Padding="10" UniformCornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Dollar" VerticalAlignment="Center" Height="30" Width="30"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Tổng doanh thu" Opacity="0.6"/>
                        <TextBlock x:Name="txblTotalRevenue" Text="0 ₫" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Margin="20,0,20,10" Padding="20" UniformCornerRadius="15">
            <Grid>
                <TextBlock Text="Biểu đồ doanh thu theo thời gian" FontWeight="Bold" Foreground="Gray"/>

                <lvc:CartesianChart Series="{Binding RevenueSeries}" LegendLocation="None">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding RevenueLabels}" Title="Thời gian"></lvc:Axis>
                    </lvc:CartesianChart.AxisX>

                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis LabelFormatter="{Binding CurrencyFormatter}" Title="Doanh thu (VNĐ)"></lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="2" Margin="10,0,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Margin="10" Padding="10" UniformCornerRadius="15">
                <Grid>
                    <TextBlock Text="Top 5 best seller" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <lvc:PieChart Series="{Binding TopProductsSeries}" 
                              LegendLocation="Bottom" 
                              InnerRadius="0" 
                              Margin="0,20,0,0"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Margin="10" Padding="10" UniformCornerRadius="15">
                <Grid>
                    <TextBlock Text="Thanh toán" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <lvc:PieChart Series="{Binding PaymentMethodSeries}" 
                              LegendLocation="Bottom" 
                              InnerRadius="40" 
                              Margin="0,20,0,0"/>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Margin="10" Padding="10" UniformCornerRadius="15">
                <Grid>
                    <TextBlock Text="Tại chỗ / Mang về" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <lvc:PieChart Series="{Binding DiningOptionSeries}" 
                              LegendLocation="Bottom" 
                              InnerRadius="40" 
                              Margin="0,20,0,0"/>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
