<Page x:Class="CoffeeShop.View.Admin.StatisticPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:local="clr-namespace:CoffeeShop.View.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1110"
      Background="#E0CEB5"
      Title="Thống kê cửa hàng">

    <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="400"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                        Orientation="Horizontal" 
                        Margin="20" 
                        VerticalAlignment="Center">
                        <DatePicker x:Name="dpStartDate" 
                            Width="120" 
                            materialDesign:HintAssist.Hint="Từ ngày"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" 
                            SelectedDateChanged="SelectedDateChangedEvt"/>

                        <TextBlock Text="-" VerticalAlignment="Center" Margin="10,0" FontWeight="ExtraBlack" Foreground="#FF340D05"/>

                        <DatePicker x:Name="dpEndDate" Width="120" 
                            materialDesign:HintAssist.Hint="Đến ngày"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDateChanged="SelectedDateChangedEvt"/>

                        <Button x:Name="btnStatistic" 
                            Content="Thống kê" Margin="20,0,0,0"
                            Width="120"
                            Foreground="#FF340D05"
                            Style="{StaticResource depotButtonStyle}" BorderBrush="#391B05"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <materialDesign:Card
                            Margin="0 20 20 20" 
                            Padding="10" 
                            UniformCornerRadius="15"
                            HorizontalAlignment="Right"
                            Width="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"></ColumnDefinition>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Dollar" VerticalAlignment="Center" Height="30" Width="30"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Tổng doanh thu thống kê  " Opacity="0.6"/>
                                    <TextBlock x:Name="txblTotalRevenue" Text="0 ₫" FontWeight="Bold" FontSize="18"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollBar Grid.Column="1" 
                                   HorizontalAlignment="Right"/>
                        </Grid>
                    </materialDesign:Card>
                    
                    <materialDesign:Card
                        Margin="0 20 20 20" 
                        Padding="10" 
                        UniformCornerRadius="15"
                        HorizontalAlignment="Right"
                        Width="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"></ColumnDefinition>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Dollar" VerticalAlignment="Center" Height="30" Width="30"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Tổng oanh thu trong ngày " Opacity="0.6"/>
                                    <TextBlock x:Name="txblTotalRevenueToday" Text="0 ₫" FontWeight="Bold" FontSize="18"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollBar Grid.Column="1" 
                                   HorizontalAlignment="Right"/>
                        </Grid>
                    </materialDesign:Card>
                    </StackPanel>

                </Grid>

                <materialDesign:Card Grid.Row="1" Margin="20,0,20,10" Padding="20" UniformCornerRadius="15">
                    <Grid>
                        <TextBlock Text="Biểu đồ doanh thu theo thời gian" FontWeight="Bold" Foreground="Gray"/>

                        <lvc:CartesianChart Series="{Binding RevenueSeries}" LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding RevenueLabels}" Title="Thời gian"></lvc:Axis>
                            </lvc:CartesianChart.AxisX>

                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding CurrencyFormatter}" Title="Doanh thu (VNĐ)"></lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </materialDesign:Card>

                <Grid Grid.Row="2" Margin="10,0,10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Margin="10" Padding="10" UniformCornerRadius="15">
                        <Grid>
                            <TextBlock Text="Top 5 bán chạy" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <lvc:PieChart Series="{Binding TopProductsSeries}" 
                                LegendLocation="Right" 
                                InnerRadius="0" 
                                Margin="0,20,0,0"
                                Hoverable="True"/>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Margin="10" Padding="10" UniformCornerRadius="15">
                        <Grid>
                            <TextBlock Text="Hình thức thanh toán" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <lvc:PieChart Series="{Binding PaymentMethodSeries}" 
                                LegendLocation="Right" 
                                InnerRadius="40" 
                                Margin="0,20,0,0"
                                Hoverable="True"/>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Margin="10" Padding="10" UniformCornerRadius="15">
                        <Grid>
                            <TextBlock Text="Hình thức sử dụng" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <lvc:PieChart Series="{Binding DiningOptionSeries}" 
                                LegendLocation="Right" 
                                InnerRadius="40" 
                                Margin="0,20,0,0"
                                Hoverable="True"
                          />
                            <ScrollBar HorizontalAlignment="Left" Margin="242,53,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
