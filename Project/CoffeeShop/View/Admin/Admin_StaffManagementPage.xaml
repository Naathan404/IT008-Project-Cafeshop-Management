<Page x:Class="CoffeeShop.View.Admin.StaffManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:CoffeeShop.View.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="910" d:DesignWidth="1110"
      Background="#E0CEB5"
      Title="EmployeePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ TÀI KHOẢN NHÂN SỰ" 
                   Grid.Row="0" Margin="30,10,0,10"
                   FontSize="24" FontWeight="ExtraBlack" Foreground="#4E342E"
                   FontFamily="Cascadia Code"/>
        
        <Border Grid.Row="1"
                Margin="30 0 30 10"
                Background="#f9f6f0"
                BorderBrush="#766839"
                BorderThickness="2"
                CornerRadius="20">
            <materialDesign:Card UniformCornerRadius="20">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="10 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  FontFamily="Cascadia Code" Height="48" Margin="5 0 5 0"
                                  materialDesign:HintAssist.Hint="Chức vụ"
                                  materialDesign:HintAssist.Foreground="#462812"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding RoleListFilter}"
                                  SelectedItem="{Binding SelectedRoleFilter}">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Chọn chức vụ" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <ComboBox Grid.Column="1"
                                  FontFamily="Cascadia Code" Height="48" Margin="5 0 5 0"
                                  materialDesign:HintAssist.Hint="Ca làm việc"
                                  materialDesign:HintAssist.Foreground="#462812"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding ShiftListFilter}"
                                  SelectedItem="{Binding SelectedShiftFilter}">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Chọn ca làm việc" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5 0 15 0" Height="48"
                                 FontFamily="Cascadia Code" FontWeight="Bold"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 materialDesign:HintAssist.Hint="Tên nhân viên..."
                                 materialDesign:HintAssist.Foreground="#462812"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#462812"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 BorderThickness="1">
                        </TextBox>

                        <Rectangle Grid.Column="3" Width="1" Fill="#462812" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="10,0">
                        <Button Command="{Binding AddCommand}"
                                Style="{StaticResource SmallButton}" Tag="AccountPlus">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Thêm nhân viên" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource SmallButton}" Tag="ContentSave">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Lưu thông tin" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button Command="{Binding DeleteCommand}"
                                Style="{StaticResource SmallButton}" Tag="TrashCan" Foreground="#B71C1C"
                                CommandParameter="{Binding ElementName=dgStaff, Path=SelectedItem}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Xóa nhân viên" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource SmallButton}" Tag="Reload">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource CustomTooltip}">
                                    <TextBlock Text="Làm mới trang" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#FF340D05"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dgStaff" Margin="30 0 10 20"
                    Style="{StaticResource CoffeeDataGridStyle}"
                    ItemsSource="{Binding EmployeeList}"
                    SelectedItem="{Binding SelectedEmployee}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Opacity="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã nhân viên" Binding="{Binding DisplayID}" Width="Auto"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>
                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding StaffName}" Width="2*"
                                            ElementStyle="{StaticResource LeftAlignStyle}"/>
                    <DataGridTextColumn Header="Chức vụ" Binding="{Binding StaffRole}" Width="*"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding Phonenumber}" Width="*"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>
                    <DataGridTextColumn Header="Ca" Binding="{Binding ShiftName}" Width="*"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    IsIndeterminate="True" 
                    Width="30"
                    Height="30"
                    Value="0"
                    Foreground="#340D05"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">
                    <TextBlock Text="Đang tải dữ liệu..." FontWeight="Bold" Foreground="Gray"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Margin="0 0 30 20" CornerRadius="20" BorderBrush="#766839" BorderThickness="2">
                <materialDesign:Card Background="#F9F6F0" UniformCornerRadius="20" materialDesign:ShadowAssist.Darken="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="{Binding Label}" 
                                           Foreground="#FF340D05" FontFamily="Cascadia Code"
                                           FontSize="18" FontWeight="ExtraBlack" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <Grid Margin="0 0 0 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedEmployee.StaffName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Họ và tên"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontFamily="Cascadia Code" FontWeight="Bold"/>
                                    <ComboBox Grid.Column="2"
                                              materialDesign:HintAssist.Hint="Giới tính"
                                              ItemsSource="{Binding GenderList}"
                                              SelectedItem="{Binding SelectedEmployee.Gender, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              FontFamily="Cascadia Code" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0 0 0 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              materialDesign:HintAssist.Hint="Chức vụ"
                                              ItemsSource="{Binding RoleList}"
                                              SelectedItem="{Binding SelectedEmployee.StaffRole, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              FontFamily="Cascadia Code"/>

                                    <ComboBox Grid.Column="2"
                                              materialDesign:HintAssist.Hint="Ca làm việc"
                                              ItemsSource="{Binding ShiftList}"
                                              SelectedItem="{Binding SelectedEmployee.ShiftName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              FontFamily="Cascadia Code"/>
                                </Grid>

                                <Grid Margin="0 0 0 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePicker Grid.Column="0"
                                              materialDesign:HintAssist.Hint="Ngày sinh"
                                              SelectedDate="{Binding SelectedEmployee.Birthday, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                              FontFamily="Cascadia Code"
                                              xml:lang="vi-VN"
                                              />

                                    <DatePicker Grid.Column="2"
                                              materialDesign:HintAssist.Hint="Ngày vào làm"
                                              SelectedDate="{Binding SelectedEmployee.StartDate, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                              FontFamily="Cascadia Code"
                                              xml:lang="vi-VN"/>
                                </Grid>

                                <TextBox Text="{Binding SelectedEmployee.Phonenumber, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Số điện thoại"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0 0 0 15" FontFamily="Cascadia Code"/>

                                <TextBox Text="{Binding SelectedEmployee.Email, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Email"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0 0 0 15" FontFamily="Cascadia Code"/>

                                <TextBox Text="{Binding SelectedEmployee.BaseSalary, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Lương cơ bản (VNĐ)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0 0 0 15" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="#2E7D32"/>

                                <Separator Background="#462812" Height="2" Margin="0 10"/>

                                <TextBox Text="{Binding SelectedEmployee.Username, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Tên đăng nhập"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0 5 0 15" FontFamily="Cascadia Code"/>

                                <PasswordBox x:Name="pwbPassword"
                                             materialDesign:HintAssist.Hint="Mật khẩu (Để trống nếu không đổi)"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             FontFamily="Cascadia Code"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </materialDesign:Card>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="30 -10 30 10"
                Background="#f9f6f0"
                BorderBrush="#766839"
                BorderThickness="2"
                CornerRadius="15">
            <Grid Margin="15 0 15 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Tổng nhân sự: " Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="ExtraBlack" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalEmployees}" Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Quản lý: " Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="ExtraBlack" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalManagers}" Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Nhân viên: " Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="ExtraBlack" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalStaffs}" Foreground="#FF340D05" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>