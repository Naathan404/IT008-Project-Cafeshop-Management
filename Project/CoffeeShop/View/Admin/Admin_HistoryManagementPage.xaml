<Page x:Class="CoffeeShop.View.Admin.HistoryManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:CoffeeShop.View.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1110"
      Background="#E0CEB5"
      Title="HistoryManagementPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Border 
            Grid.Row="0"
            Margin="30 10 30 10"
            Background="#f9f6f0"
            BorderBrush="#766839"
            BorderThickness="2"
            CornerRadius="20">
            <materialDesign:Card
                UniformCornerRadius="20">
                <Grid
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="15 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="4*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <DatePicker
                            SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Column="0"
                            xml:lang="vi-VN"
                            Margin="0 0 0 0"
                            FontFamily="Cascadia Code"
                            Height="48"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.Hint="Từ ngày..."
                            materialDesign:HintAssist.Foreground="#462812"
                            materialDesign:HintAssist.Background="Transparent"
                            materialDesign:TextFieldAssist.UnderlineBrush="#462812"                            
                            materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                            BorderThickness="1"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" 
                            ToolTip="Ngày bắt đầu"
                                >
                            <DatePicker.Resources>
                                <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#391B05"/>
                                <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#E0CEB5"/>
                                <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#B18252"/>
                                <SolidColorBrush x:Key="MaterialDesignPaper" Color="#F9F6F0"/>
                            </DatePicker.Resources>
                        </DatePicker>
                        
                        <DatePicker
                            SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Column="1"
                            xml:lang="vi-VN"
                            Margin="10 0 0 0"
                            FontFamily="Cascadia Code"
                            Height="48"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.Hint="Đến ngày..."
                            materialDesign:HintAssist.Foreground="#462812"
                            materialDesign:HintAssist.Background="Transparent"
                            materialDesign:TextFieldAssist.UnderlineBrush="#462812"                            
                            materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                            BorderThickness="1"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            ToolTip="Ngày kết thúc"
                            >
                            <DatePicker.Resources>
                                <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#391B05"/>
                                <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#E0CEB5"/>
                                <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#B18252"/>
                                <SolidColorBrush x:Key="MaterialDesignPaper" Color="#F9F6F0"/>
                            </DatePicker.Resources>
                        </DatePicker>

                        <ComboBox
                            Grid.Column="2"
                            FontFamily="Cascadia Code"
                            Height="48"
                            Margin="10 0 0 0"
                            materialDesign:HintAssist.Hint="Hình thức"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            ItemsSource="{Binding PaymentMethods, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Chọn hình thức thanh toán"
                            >
                        </ComboBox>


                        <TextBox
                            Text="{Binding CustomerNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Column="3"
                            Margin="10 0 15 0"
                            Height="48"
                            FontFamily="Cascadia Code"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.Hint="Họ tên khách hàng"
                            materialDesign:HintAssist.Foreground="#462812"
                            materialDesign:HintAssist.Background="Transparent"
                            materialDesign:TextFieldAssist.UnderlineBrush="#462812"
                            AcceptsReturn="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            materialDesign:TextFieldAssist.OutlinedBorderActiveThickness="3"
                            BorderThickness="1"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            ToolTip="Tìm kiếm theo họ tên khách hàng">
                        </TextBox>
                    </Grid>

                    <Grid
                        Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Command="{Binding RefreshPageCommand}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Padding="0"
                            Margin="0 0 15 0"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Background="#E0ceb5"
                            HorizontalAlignment="Right"
                            Height="50"
                            Width="50"
                            BorderBrush="#67582c"
                            BorderThickness="2" >
                            <materialDesign:PackIcon
                                    Foreground="#340D05"
                                    Kind="Refresh"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Height="40"
                                    Width="40">
                            </materialDesign:PackIcon>
                        </Button>
                        
                        <Button
                            Grid.Column="1"
                            Command="{Binding ShowOrderDetailCommand}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Padding="0"
                            Margin="0 0 15 0"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Background="#E0ceb5"
                            HorizontalAlignment="Right"
                            Height="50"
                            Width="50"
                            BorderBrush="#67582c"
                            BorderThickness="2" >
                            <materialDesign:PackIcon
                                    Foreground="#340D05"
                                    Kind="InformationSlabCircle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Height="40"
                                    Width="40">
                            </materialDesign:PackIcon>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Command="{Binding PrintCommand}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Padding="0"
                            Margin="0 0 15 0"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Background="#E0ceb5"
                            HorizontalAlignment="Right"
                            Height="50"
                            Width="50"
                            BorderBrush="#67582c"
                            BorderThickness="2" >
                            <materialDesign:PackIcon
                                    Foreground="#340D05"
                                    Kind="Printer"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Height="40"
                                    Width="40">
                            </materialDesign:PackIcon>
                        </Button>
                        
                        <Button
                            Grid.Column="3"
                            Command="{Binding ExportExcelCommand}"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Padding="0"
                            Margin="0 0 15 0"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Background="#E0ceb5"
                            HorizontalAlignment="Right"
                            Height="50"
                            Width="50"
                            BorderBrush="#67582c"
                            BorderThickness="2" >
                            <materialDesign:PackIcon
                                    Foreground="#340D05"
                                    Kind="FileExport"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Height="40"
                                    Width="40">
                            </materialDesign:PackIcon>
                        </Button>

                    </Grid>
                </Grid>

            </materialDesign:Card>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                BorderBrush="#BC9466"   
                BorderThickness="10"
                CornerRadius="5"
                Margin="30 0 15 20">

                <DataGrid
                        ItemsSource="{Binding Orders}"
                        SelectedItem="{Binding SelectedOrder}"
                        ColumnHeaderStyle="{StaticResource dgHeaderStyle}"
                        AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserResizeColumns="False" CanUserReorderColumns="False"
                        HorizontalAlignment="Stretch"
                        GridLinesVisibility="None"
                        IsReadOnly="true"
                        ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã hóa đơn" Width="4*" Binding="{Binding DisplayID}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tên khách hàng" Width="6*" Binding="{Binding CustomerName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thời gian" Width="4*" Binding="{Binding OrderDate}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Hình thức" Width="4*" Binding="{Binding PaymentMethod}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tổng tiền" Width="4*" Binding="{Binding Total}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0 0 30 20"
                CornerRadius="20"
                BorderBrush="#766839"
                BorderThickness="2">
                <materialDesign:Card
                    Background="#F9F6F0"
                    UniformCornerRadius="20"
                    materialDesign:ShadowAssist.Darken="True">

                    <Grid
                        Visibility="{Binding OrderDetailVisibility}"
                        Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <StackPanel 
                            Grid.Row="0"
                            Orientation="Horizontal">
                            <TextBlock
                                Text="Mã hóa đơn: "
                                Foreground="#FF340D05"
                                FontFamily="Cascadia Code"
                                FontSize="15"
                                FontWeight="ExtraBlack"
                                VerticalAlignment="Center"
                            ></TextBlock>

                            <TextBlock
                                Text="{Binding SelectedOrder.DisplayID, Mode=TwoWay}"
                                Foreground="#FF340D05"
                                FontFamily="Cascadia Code"
                                FontSize="15"
                                FontWeight="Bold"
                                VerticalAlignment="Center">
                            </TextBlock>
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Margin="0 5 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel 
                                Grid.Column="0"
                                Orientation="Horizontal">
                                <TextBlock
                                    Text="Thời gian: "
                                    Foreground="#FF340D05"
                                    FontFamily="Cascadia Code"
                                    FontSize="15"
                                    FontWeight="ExtraBlack"
                                    VerticalAlignment="Center"
                                ></TextBlock>
                                <TextBlock
                                    Text="{Binding SelectedOrder.OrderDate, Mode=TwoWay}"
                                    Foreground="#FF340D05"
                                    FontFamily="Cascadia Code"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center">
                                </TextBlock>
                            </StackPanel>

                            <StackPanel 
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                                <TextBlock
                                    Text="Bàn: "
                                    Foreground="#FF340D05"
                                    FontFamily="Cascadia Code"
                                    FontSize="15"
                                    FontWeight="ExtraBlack"
                                    VerticalAlignment="Center"
                                ></TextBlock>
                                <TextBlock
                                    Text="{Binding SelectedOrder.TableName, Mode=TwoWay}"
                                    Foreground="#FF340D05"
                                    FontFamily="Cascadia Code"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center">
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <StackPanel 
                            Grid.Row="2"
                            Margin="0 5 0 0"
                            Orientation="Horizontal">
                            <TextBlock
                                Text="Hình thức thanh toán: "
                                Foreground="#FF340D05"
                                FontFamily="Cascadia Code"
                                FontSize="15"
                                FontWeight="ExtraBlack"
                                VerticalAlignment="Center"
                            ></TextBlock>

                            <TextBlock
                                Text="{Binding SelectedOrder.PaymentMethod, Mode=TwoWay}"
                                Foreground="#FF340D05"
                                FontFamily="Cascadia Code"
                                FontSize="15"
                                FontWeight="Bold"
                                VerticalAlignment="Center">
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="3"
                            Background="#F9F6F0"
                            Margin="0">
                            <DataGrid x:Name="dtgListOrder"
                                ItemsSource="{Binding OrderDetails}"
                                AutoGenerateColumns="False"
                                IsReadOnly="False"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                GridLinesVisibility="None"
                                Background="#F9F6F0"
                                FontFamily="Cascadia Code"
                                FontSize="10"
                                Margin="0 10 0 0"
                                AlternationCount="1000000"
                                EnableRowVirtualization="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F9F6F0"/>
                                        <Setter Property="Foreground" Value="#462812"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontFamily" Value="Cascadia Code"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="BorderThickness" Value="1 1 1 1"/>
                                        <Setter Property="BorderBrush" Value="#766839"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#766839"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="FontFamily" Value="Cascadia Code"/>
                                        <Setter Property="Background" Value="#F9F6F0"/>
                                        <Setter Property="BorderBrush" Value="#A0A0A0"/>
                                        <Setter Property="BorderThickness" Value="1 1 1 1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="Auto"/>
                                        <Setter Property="MinHeight" Value="40"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Tên sản phẩm" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Left" 
                                                VerticalAlignment="Center"
                                                Margin="5">
                                                    <TextBlock Text="{Binding ItemName}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold" 
                                                   FontSize="15" 
                                                   Foreground="#766839"
                                                   TextWrapping="Wrap"/>
                                                    <!--
                                                    <TextBlock Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Width="130" Height="25" 
                                                   Margin="0 5 0 0"
                                                   FontFamily="Cascadia Code"
                                                   FontSize="15" 
                                                   Foreground="#C7A57A"/>
                                                    -->
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Số lượng"
                                            Width="0.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Quantity}"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" 
                                               FontSize="15" 
                                               Foreground="#766839"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Thành tiền" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalPrice}"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontWeight="Bold" 
                                               FontSize="15" 
                                               Foreground="#766839"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>

        <Border 
            Grid.Row="2"
            Margin="30 -10 30 10"
            Background="#f9f6f0"
            BorderBrush="#766839"
            BorderThickness="2"
            CornerRadius="15">
        </Border>
    </Grid>
</Page>
