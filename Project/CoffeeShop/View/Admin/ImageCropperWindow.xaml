<Window x:Class="CoffeeShop.View.Admin.ImageCropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cắt ảnh món ăn" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" Background="#222">
    <Grid Background="#222222">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="10" BorderBrush="#444" BorderThickness="1" ClipToBounds="True">
            <Grid x:Name="ContainerGrid">
                <Image x:Name="SourceImage" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Canvas x:Name="CanvasCropper" 
                        Width="{Binding ElementName=SourceImage, Path=ActualWidth}"
                        Height="{Binding ElementName=SourceImage, Path=ActualHeight}"
                        Background="Transparent">

                    <Path Fill="#AA000000" IsHitTestVisible="False">
                        <Path.Data>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry x:Name="FullArea" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry x:Name="CropArea" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <Rectangle x:Name="SelectionRect" 
                               Stroke="Gold" 
                               StrokeThickness="3" 
                               StrokeDashArray="4 2"
                               Fill="Transparent" 
                               Width="250" Height="180" 
                               Cursor="SizeAll"
                               MouseDown="Canvas_MouseDown" 
                               MouseMove="Canvas_MouseMove" 
                               MouseUp="Canvas_MouseUp"/>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
            <TextBlock Text="Kéo khung vàng để chọn vùng ảnh" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       Margin="0,0,20,0" 
                       Opacity="0.7"/>
            <Button Content="Xác nhận cắt" 
                    Click="Crop_Click" 
                    Width="135" Height="40" 
                    Background="#B18252" 
                    Foreground="White" 
                    FontWeight="Bold"
                    FontFamily="Cascadia Code"
                    FontSize="15"/>
            <Button Content="Hủy" 
                    Click="Cancel_Click" 
                    Margin="10,0,0,0" 
                    Width="80" 
                    Background="Transparent" 
                    Foreground="Gray"
                    FontFamily="Cascadia Code"
                    FontSize="15"/>
        </StackPanel>
    </Grid>
</Window>