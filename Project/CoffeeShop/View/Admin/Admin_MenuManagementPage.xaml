<Page x:Class="CoffeeShop.View.Admin.MenuManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:vm="clr-namespace:CoffeeShop.ViewModels.AdminVM"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1310"
      xmlns:local="clr-namespace:CoffeeShop.View.Admin"
      Title="MenuManagementPage">
    <!-- ===================== -->
    <!-- Resources -->
    <!-- ===================== -->
    <Page.Resources>
        <local:ObjectEqualsConverter x:Key="ObjectEqualsConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:GreaterThanOneConverter x:Key="GreaterThanOneConverter"/>

        <!-- Style for Action Buttons (Edit, Delete) -->
        <Style x:Key="ActionButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="#D4BA98"/>
            <Setter Property="BorderBrush" Value="#B18252"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0 0 2.5 0"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#766839"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for Item card -->
        <Style x:Key="AdminItemCard" TargetType="ContentControl">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="BorderContainer"
                                Background="#E0CEB5" CornerRadius="15"
                                MinWidth="130" MinHeight="150" 
                                MaxHeight="220" MaxWidth="200"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Ảnh -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Tên -->
                                    <RowDefinition Height="*"/>
                                    <!-- EMPTY SPACE -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Size -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Giá -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Buttons -->
                                </Grid.RowDefinitions>
                                <!--Item Image-->
                                <Image x:Name="imgItem"
                                       Grid.Row="0"
                                       Margin="10" MaxHeight="80"
                                       Stretch="UniformToFill"
                                       Source="{Binding ImagePath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                       d:Source="/Assets/Images/imgItemExample.jpg">
                                </Image>
                                <!--Item Name-->
                                <TextBlock x:Name="txtblItemName"
                                           Text="{Binding ItemName}"
                                           Grid.Row="1"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="10 0 10 0"
                                           FontFamily="Bahnschrift"
                                           Foreground="#340D05"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                <Grid Grid.Row="2"></Grid>
                                <!--Item Size - Hiển thị sizes bằng ItemsControl-->
                                <ItemsControl Grid.Row="3"
                                              ItemsSource="{Binding ItemPrices}"
                                              Margin="0 5 10 0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <!-- Hiển thị nếu có nhiều hơn 1 size -->
                                                <DataTrigger Binding="{Binding ItemPrices.Count, Converter={StaticResource GreaterThanOneConverter}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- Ẩn nếu chỉ có 1 size và là Food (CategoryId = 7) -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ItemPrices.Count}" Value="1"/>
                                                        <Condition Binding="{Binding CategoryId}" Value="7"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#766839"
                                                    BorderThickness="2"
                                                    CornerRadius="15"
                                                    Width="20" Height="20"
                                                    Margin="0 0 2.5 0">
                                                <TextBlock Text="{Binding Size.SizeName}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Bahnschrift"
                                                           Foreground="#766839"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--Item Price - Hiển thị giá đầu tiên-->
                                <TextBlock Grid.Row="4"
                                           FontFamily="Bahnschrift"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#766839"
                                           Margin="0 2 12 5"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:N0} VND">
                                            <Binding Path="ItemPrices[0].Price"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                
                                <!--Edit & Delete Buttons-->
                                <Grid Grid.Row="5" Margin="0 0 0 10"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="bdrEditItem"
                                            MouseDown="EditItem_Click"
                                            Grid.Column="0"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <materialDesign:PackIcon Kind="CircleEditOutline"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"
                                                                 Width="15" Height="15"
                                                                 Foreground="#F9F6F0"/>
                                    </Border>

                                    <Border x:Name="bdrDeleteItem"
                                            MouseDown="DeleteItem_Click"
                                            Grid.Column="1"
                                            Style="{StaticResource ActionButtonStyle}">
                                        <materialDesign:PackIcon Kind="Delete"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"
                                                                 Width="15" Height="15"
                                                                 Foreground="#F9F6F0"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#340D05" 
                                                          Direction="315" 
                                                          ShadowDepth="3" 
                                                          BlurRadius="10" 
                                                          Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Item đang được chọn -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ObjectEqualsConverter}">
                                        <!-- SelectedItem -->
                                        <Binding Path="DataContext.SelectedItem"
                                                 RelativeSource="{RelativeSource AncestorType=Page}"/>
                                        <!-- Item hiện tại -->
                                        <Binding/>
                                    </MultiBinding>
                                </DataTrigger.Binding>

                                <Setter TargetName="BorderContainer" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black"
                                                          Direction="315"
                                                          ShadowDepth="7"
                                                          Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BorderContainer" Property="Background" Value="#D5BCA1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- ===================== -->
    <!-- Layout -->
    <!-- ===================== -->
    <Grid Background="#D4BA98">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        <Grid>
            <Border Grid.Column="0" 
                    Margin="20" 
                    Background="#EDE2D3" 
                    CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                       Opacity="0.3"
                       Color="Black"
                       ShadowDepth="8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10 5 10 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    VerticalAlignment="Center"
                                    Margin="0 5 10 10">
                            <materialDesign:PackIcon Kind="Magnify" 
                                                     Margin="0 0 5 0" 
                                                     VerticalAlignment="Center" 
                                                     Width="25" Height="25" 
                                                     Foreground="#766839"/>
                            <TextBox x:Name="txblSearchItem"
                                     Text="{Binding SearchItemKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35" 
                                     MinWidth="180"
                                     FontSize="15"
                                     FontWeight="Bold"
                                     Foreground="#462812"
                                     materialDesign:HintAssist.Hint="Tìm kiếm"
                                     materialDesign:HintAssist.FontFamily="Cascadia Code"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </StackPanel>

                        <TabControl x:Name="tabMain"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Left"
                                    SelectedItem="{Binding SelectedTabItem}">

                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                    <Setter Property="Height" Value="45"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                           FontSize="15"
                                                           FontFamily="Cascadia Code" 
                                                           FontWeight="Bold"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabItem Header="Tất cả" Tag="0"/>
                            <TabItem Header="Cà phê" Tag="1"/>
                            <TabItem Header="Trà sữa" Tag="2"/>
                            <TabItem Header="Đá xay" Tag="3"/>
                            <TabItem Header="Trà" Tag="4"/>
                            <TabItem Header="Nước ép" Tag="5"/>
                            <TabItem Header="Sinh tố" Tag="6"/>
                            <TabItem Header="Food" Tag="7"/>
                        </TabControl>
                    </Grid>

                    <Border Grid.Row="1" Margin="10 0 10 10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      SizeChanged="ItemsContainer_SizeChanged">
                            <ItemsControl ItemsSource="{Binding FilteredItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource AdminItemCard}" 
                                                        Content="{Binding}" Margin="5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!--Buttons-->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="15">
            <Border x:Name="bdrAddNewItem"
                    BorderBrush="#766839"
                    BorderThickness="2"
                    Margin="30 0 0 0"
                    Padding="10"
                    CornerRadius="15"
                    Cursor="Hand"
                    Background="#EDE2D3"
                    MouseEnter="border_MouseEnter"
                    MouseLeave="border_MouseLeave"
                    MouseDown="AddNewItem_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                       Opacity="0.3"
                       Color="Black"
                       ShadowDepth="8"/>
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding Command="{Binding DataContext.SetIsAvailableForItem,
                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"
                                  MouseAction="LeftClick"/>
                </Border.InputBindings>
                <TextBlock Text="Thêm món"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code"
                           Foreground="#766839"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
