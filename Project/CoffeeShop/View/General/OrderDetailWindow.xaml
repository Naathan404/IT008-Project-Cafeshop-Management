<Window x:Class="CoffeeShop.View.General.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop.View.Staff"
        mc:Ignorable="d"
        Title="Chi tiết mua hàng" Height="610" Width="800"
        Background="#E0CEB5"
        WindowStartupLocation="CenterScreen"
        MinHeight="610"
        MinWidth="800"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="350"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                x:Name="txblOrderID"
                Text="Mã hóa đơn: HDXXXXX-XXXX"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="20"
                Margin="20 5 5 5"
                VerticalAlignment="Bottom"></TextBlock>
            <TextBlock Grid.Column="1"
                x:Name="txblTable"
                Text="Bàn: XX"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="20"
                HorizontalAlignment="Right"
                Margin="5 5 20 5"
                VerticalAlignment="Bottom"></TextBlock>            
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                x:Name="txblOrderDate"
                Text="Thời gian: dd//mm/yyyy HH:mm:ss"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Left"
                Margin="20 5 5 5"></TextBlock>
            <TextBlock Grid.Column="1"
                x:Name="txblPaymentMethod"
                Text="Chuyển khoản"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 20 5"></TextBlock>            
        </Grid>

        <TextBlock Grid.Row="2"
            x:Name="txblCustomer"
            Text="Khách hàng: Nguyễn Chí Nguyên"
            Foreground="#FF340D05"
            FontFamily="Cascadia Code"
            FontWeight="Bold"
            FontSize="18"
            HorizontalAlignment="Left"
            Margin="20 5 5 5"></TextBlock>

        <TextBlock Grid.Row="3"
            x:Name="txblemployee"
            Text="Nhân viên: Lê Thành Nghĩa"
            Foreground="#FF340D05"
            FontFamily="Cascadia Code"
            FontWeight="Bold"
            FontSize="18"
            HorizontalAlignment="Left"
            Margin="20 5 5 5"></TextBlock>

        <Border Grid.Row="4"
                Margin="20 10 20 5"
                BorderBrush="#BC9466"
                BorderThickness="10"
                CornerRadius="5">
            <DataGrid 
                x:Name="dgOrderDetail"
                AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserResizeColumns="False" CanUserReorderColumns="False"
                HorizontalAlignment="Stretch"
                GridLinesVisibility="None"
                IsReadOnly="true"
                ColumnHeaderStyle="{StaticResource dgHeaderTemplate}"
                >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên món" Width="4*" Binding="{Binding oName}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Size" Width="1*" Binding="{Binding oSize}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Số lượng" Width="2*" Binding="{Binding oQuantity}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn giá" Width="3*" Binding="{Binding oPrice}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Thành tiền" Width="3*" Binding="{Binding oTotal}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" Width="4*" Binding="{Binding oNote}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Tạm tính: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
            <TextBlock Grid.Column="2"
                x:Name="txblSubTotal"
                Text="10.000.000"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Giảm giá: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
                    <TextBlock Grid.Column="2"
                x:Name="txblDiscountMoney"
                Text="10.000.000"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Tổng cộng: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
            <TextBlock Grid.Column="2"
                x:Name="txblTotalAmount"
                Text="10.000.000"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>
    </Grid>
</Window>
