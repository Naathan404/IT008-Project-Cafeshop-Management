<Window x:Class="CoffeeShop.View.General.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop.View.Staff"
        mc:Ignorable="d"
        Title="Chi tiết mua hàng" Height="610" Width="800"
        Background="#E0CEB5"
        WindowStartupLocation="CenterScreen"
        MinHeight="610"
        MinWidth="800"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="350"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel 
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock
                    Text="Mã hóa đơn: "
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="20 5 0 5"
                    VerticalAlignment="Bottom">
                </TextBlock>
                <TextBlock
                    Text="{Binding DisplayID}"
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="0 5 5 5"
                    VerticalAlignment="Bottom">
                </TextBlock>                
            </StackPanel>
            <StackPanel 
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <TextBlock
                    Text="{Binding TableName}"
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="0 5 20 5"
                    VerticalAlignment="Bottom">
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel 
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock
                    Text="Ngày tạo: "
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="20 5 0 5"
                    VerticalAlignment="Bottom">
                </TextBlock>
                <TextBlock
                    Text="{Binding OrderDate}"
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="0 5 5 5"
                    VerticalAlignment="Bottom">
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1"
                x:Name="txblPaymentMethod"
                Text="{Binding PaymentMethod}"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 20 5">
            </TextBlock>            
        </Grid>

        <StackPanel 
                Grid.Row="2"
                Orientation="Horizontal">
            <TextBlock
                    Text="Khách hàng: "
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="20 5 0 5"
                    VerticalAlignment="Bottom">
            </TextBlock>
            <TextBlock
                    Text="{Binding CustomerName}"
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="0 5 5 5"
                    VerticalAlignment="Bottom">
            </TextBlock>
        </StackPanel>

        <StackPanel 
                Grid.Row="3"
                Orientation="Horizontal">
            <TextBlock
                    Text="Nhân viên: "
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="20 5 0 5"
                    VerticalAlignment="Bottom">
            </TextBlock>
            <TextBlock
                    Text="{Binding StaffName}"
                    Foreground="#FF340D05"
                    FontFamily="Cascadia Code"
                    FontWeight="Bold"
                    FontSize="20"
                    Margin="0 5 5 5"
                    VerticalAlignment="Bottom">
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="4"
                Margin="20 10 20 5"
                BorderBrush="#BC9466"
                BorderThickness="10"
                CornerRadius="5">
            <DataGrid 
                ItemsSource="{Binding OrderDetails}"
                AutoGenerateColumns="False" CanUserAddRows="False"
                CanUserResizeColumns="False" CanUserReorderColumns="False"
                HorizontalAlignment="Stretch"
                GridLinesVisibility="None"
                IsReadOnly="true"
                ColumnHeaderStyle="{StaticResource dgHeaderStyle}"
                >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên món" Width="4*" Binding="{Binding ItemName}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Size" Width="1*" Binding="{Binding SizeName}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số lượng" Width="2*" Binding="{Binding Quantity}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn giá" Width="2*" Binding="{Binding UnitPrice}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Thành tiền" Width="2*" Binding="{Binding TotalPrice}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ghi chú" Width="3*" Binding="{Binding Note}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Tạm tính: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
            <TextBlock Grid.Column="2"
                x:Name="txblSubTotal"
                Text="{Binding SubTotal}"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Giảm giá: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
                    <TextBlock Grid.Column="2"
                x:Name="txblDiscountMoney"
                Text="{Binding DiscountMoney}"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                Text="Tổng cộng: "
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5"></TextBlock>
            <TextBlock Grid.Column="2"
                x:Name="txblTotalAmount"
                Text="{Binding TotalAmount}"
                Foreground="#FF340D05"
                FontFamily="Cascadia Code"
                FontWeight="Bold"
                FontSize="18"
                HorizontalAlignment="Right"
                Margin="5 5 25 5"></TextBlock>
        </Grid>
    </Grid>
</Window>
