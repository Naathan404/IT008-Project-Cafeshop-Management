<Page x:Class="CoffeeShop.View.General.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop.View.General"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1100"
      Title="AccountPage"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.Resources>
        <SolidColorBrush x:Key="CardBgColor" Color="#392805"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#340D05"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#D7CCC8"/>
        <SolidColorBrush x:Key="LightBgColor" Color="#f9f6f0"/>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InfoCardItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#F0EBE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#6D4C41" Opacity="0.08" BlurRadius="8" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop x:Name="GradientStop1" Color="#f9f6f0" Offset="0"/>
                <GradientStop x:Name="GradientStop2" Color="#c7a57a" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <materialDesign:Card Width="900" Height="500"
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Center"
                             Background="{StaticResource LightBgColor}"
                             UniformCornerRadius="30"
                             Padding="0">
            <materialDesign:Card.Effect>
                <DropShadowEffect Color="#340D05" Opacity="0.5" BlurRadius="20" ShadowDepth="5"/>
            </materialDesign:Card.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBgColor}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <Grid HorizontalAlignment="Center" Margin="0 0 0 20">
                            <Ellipse Width="130" Height="130" Stroke="{StaticResource SecondaryColor}" StrokeThickness="4"/>
                            <materialDesign:PackIcon Kind="AccountCircle" 
                                                     Width="120" Height="120"
                                                     Foreground="{StaticResource LightBgColor}"
                                                     VerticalAlignment="Center" 
                                                     HorizontalAlignment="Center"/>
                            <Border Width="24" Height="24" CornerRadius="12" Background="#4CAF50" 
                                    BorderBrush="{StaticResource PrimaryColor}" BorderThickness="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,10,15,15"/>
                        </Grid>

                        <TextBlock Text="{Binding Name}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource LightBgColor}" 
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="15,15,15,5"/>

                        <TextBlock Text="{Binding ID}"
                                   Foreground="{StaticResource SecondaryColor}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <Border Background="{StaticResource SecondaryColor}" CornerRadius="15" Padding="20,5" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BadgeAccountHorizontal" 
                                                         Foreground="{StaticResource PrimaryColor}" 
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Role}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"/>
                            </StackPanel>
                        </Border>
                        
                        <!--
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{StaticResource SecondaryColor}"
                                BorderBrush="{StaticResource SecondaryColor}"
                                Content="Đổi mật khẩu"
                                Height="35" FontSize="12"
                                Margin="0,30,0,0"
                                materialDesign:ButtonAssist.CornerRadius="18"/>
                        -->
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="30,20,30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="HỒ SƠ CÁ NHÂN" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                        <Separator Background="{StaticResource PrimaryColor}" Opacity="1" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource InfoCardItem}" Grid.ColumnSpan="2" Margin="5,5,5,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountKey" Width="20" Height="20" Foreground="{StaticResource PrimaryColor}"/>
                                <TextBlock Grid.Column="1" Text="Tên đăng nhập" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Username}" Style="{StaticResource ValueText}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoCardItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="20" Height="20" Foreground="{StaticResource PrimaryColor}"/>
                                <TextBlock Grid.Column="1" Text="Ca làm việc" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Shift}" Style="{StaticResource ValueText}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource InfoCardItem}" Grid.ColumnSpan="2" Margin="5,5,5,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="EmailOutline" Width="20" Height="20" Foreground="{StaticResource PrimaryColor}"/>
                                <TextBlock Grid.Column="1" Text="Email" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Email}" Style="{StaticResource ValueText}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoCardItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="PhoneOutline" Width="20" Height="20" Foreground="{StaticResource PrimaryColor}"/>
                                <TextBlock Grid.Column="1" Text="Điện thoại" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Phonenumber}" Style="{StaticResource ValueText}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource InfoCardItem}" Margin="4,15,4,4" Background="#F1F8E9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="WalletMembership" Width="24" Height="24" Foreground="#2E7D32"/>
                                <TextBlock Grid.Column="1" Text="Mức lương cơ bản" Style="{StaticResource LabelText}" Foreground="#2E7D32" Opacity="1"/>
                                <TextBlock Grid.Column="1"  Text="{Binding BaseSalary}" 
                                           Style="{StaticResource ValueText}" Foreground="#2E7D32" FontSize="18"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="btnReturn"
                                Command="{Binding QuitCommand}"
                                Content="THOÁT"
                                Height="45" Width="130"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="22"
                                Foreground="{StaticResource PrimaryColor}"
                                Background="#e0ceb5"
                                FontWeight="Bold" FontSize="14"
                                Margin="0,0,10,0"/>

                        <Button x:Name="btnLogout"
                                Command="{Binding LogoutCommand}"
                                Content="ĐĂNG XUẤT"
                                Height="45" Width="130"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="22"
                                Background="{StaticResource CardBgColor}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                Foreground="White"
                                FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>