<Page x:Class="CoffeeShop.View.Login.ForgotPasswordStep2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="500" d:DesignWidth="680"
      Title="ForgotPasswordStep2"
      MinHeight="500" MinWidth="680"
      FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#E0CEB5"/>
                <GradientStop Color="#F9F6F0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="30"
                Height="450" Width="600"
                HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="ĐÃ GỬI MÃ XÁC NHẬN"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="30,30,0,15"/>
                    <TextBlock Text="Chúng tôi đã gửi một mã xác nhận gồm 5 ký tự đến địa chỉ email của bạn. Vui lòng nhập mã vào ô bên dưới để tiếp tục."
                               FontSize="20"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               Opacity="0.8"
                               Margin="30,0,30,20"/>
                </StackPanel>

                <StackPanel Margin="0,40,0,0">
                    <TextBlock x:Name="txblNotify"
                        Text="Mã xác nhận không hợp lệ. Vui lòng nhập lại!"
                        FontSize="15"
                        Foreground="Red"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Height="50" Width="200"
                                CornerRadius="7"
                                BorderBrush="Gray" BorderThickness="1">
                            <TextBox x:Name="txbVeriCode"
                                     Text=""
                                     FontSize="30"
                                     Padding="20,0,0,0"
                                     MaxLength="5"
                                     KeyDown="txbVeriCode_KeyDown"
                                     TextChanged="txbVeriCode_TextChanged"
                                     materialDesign:TextFieldAssist.UnderlineBrush="gray"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"/>
                        </Border>
                    </StackPanel>

                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="Không nhận được mã? "
                                FontSize="15"
                                VerticalAlignment="Center"/>
                        <Button Content="Gửi lại"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#B18252"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                Padding="0"
                                VerticalAlignment="Center" 
                                Click="btnResend_Click"/>
                    </StackPanel>

                    <StackPanel Margin="0">
                        <Button x:Name="btnNext"
                                Content="XÁC MINH"
                                Width="250" Height="40"
                                HorizontalAlignment="Center"
                                Background="#B18252"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Click="btnNext_Click"/>

                        <Button x:Name="btnBack"
                                Content="QUAY LẠI"
                                Width="250" Height="40"
                                HorizontalAlignment="Center"
                                Background="#D3D3D3"
                                Foreground="White"
                                FontSize="16"
                                Margin="0,10,0,0"
                                FontWeight="SemiBold"
                                Click="btnBack_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
