<Window x:Name="Cafeshop___Staff" x:Class="CoffeeShop.View.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Coffeeshop - Staff" Height="450" Width="800"
        WindowState="Normal">

    <Grid Background="#FFD4BA98">
        <Border Background="#B18252" 
                Margin="0,30,0,0"/>

        <materialDesign:Card x:Name="crdTableAndMenu"
                             Margin="7 37 400 0"
                             Background="Transparent">
            <TabControl
                HorizontalContentAlignment="Left"
                TabStripPlacement="Top"
                BorderThickness="0"
                Margin="0">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Margin" Value="0,0,7,0"/>
                        <Setter Property="Background" Value="#B18252"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontFamily" Value="Noto Sans SC Black"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10 10 0 0"
                                            BorderBrush="#4A3F2A"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F9F6F0"/>
                                            <Setter Property="Foreground" Value="#340D05"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#E0CEB5"/>
                                            <Setter Property="Foreground" Value="#F9F6F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Bàn">
                    <Border Background="#F9F6F0" 
                            CornerRadius="0 15 0 0"/>
                </TabItem>

                <TabItem Header="Thực đơn">
                    <Border Background="#F9F6F0" 
                            CornerRadius="0 15 0 0"/>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>
