<Window x:Name="Cafeshop___Staff" x:Class="CoffeeShop.View.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Coffeeshop - Staff"
        WindowState="Normal"
        Height="520" Width="850"
        MinHeight="520" MinWidth="850">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#FFB18252" 
                             Opacity="0.95"/>
        </Grid.Background>
        <Border Background="#D7BF9F" 
                Margin="0,36,0,0"
                CornerRadius="20 20 0 0">
        </Border>

        <materialDesign:Card x:Name="crdTableAndMenu"
                             Margin="15 50 350 0"
                             Background="Transparent">
            <TabControl
                HorizontalContentAlignment="Left"
                TabStripPlacement="Top"
                BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Foreground" Value="#856539"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Margin" Value="0,0,7,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontFamily" Value="Noto Sans SC Black"/>
                        <Setter Property="Height" Value="37"/>
                        <Setter Property="Width" Value="80"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10 10 0 0"
                                            BorderBrush="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#340D05"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Bàn">
                    <Border Background="#FFFFFF" 
                            CornerRadius="0 25 0 0">
                        <Border CornerRadius="11" 
                            BorderBrush="#B18252" 
                            BorderThickness="1" 
                            Padding="0"
                            Background="Transparent"
                            Margin="12 12 0 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <ComboBox x:Name="cbxFilterTable"
                                      FontFamily="Cascadia Code"
                                      FontSize="12"
                                      Foreground="#340D05"
                                      BorderBrush="Transparent"
                                      Margin="10 2 4 2"
                                      Height="21"
                                      materialDesign:HintAssist.Hint="Tất cả các loại bàn"
                                      materialDesign:TextFieldAssist.UnderlineBrush="#856539">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="MaterialDesignOutlinedBorderBrush" Color="#B18252"/>
                                    <SolidColorBrush x:Key="MaterialDesignTextBoxBorder" Color="#B18252"/>
                                </ComboBox.Resources>

                                <ComboBoxItem Content="Tất cả"/>
                                <ComboBoxItem Content="Bàn 2"/>
                                <ComboBoxItem Content="Bàn 4"/>
                            </ComboBox>
                        </Border>
                    </Border>
                </TabItem>

                <TabItem Header="Thực đơn">
                    <Border Background="#FFFFFF" 
                            CornerRadius="0 25 0 0"/>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
        <Border x:Name="recLogOut"
                CornerRadius="10"
                Background="#58481F"
                Width="20"
                Height="20" 
                Margin="10,10,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <materialDesign:PackIcon Kind="ChevronRight" 
                                     Margin="2"
                                     Foreground="#E7D8C4"/>
        </Border>
        <TextBlock Text="Coffee shop"
                 FontFamily="Segoe UI Black"
                 FontSize="15"
                 Foreground="#FFE7D8C4"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="40 9 0 0"/>
    </Grid>
</Window>
