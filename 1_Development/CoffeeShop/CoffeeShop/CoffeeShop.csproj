<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Model\**" />
    <EmbeddedResource Remove="Model\**" />
    <None Remove="Model\**" />
    <Page Remove="Model\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\icoCoffee.ico" />
    <None Remove="Assets\Images\cuteCoffeeCup.jpg" />
    <None Remove="Assets\Images\imgBanner_1.png" />
    <None Remove="Assets\Images\imgBanner_2.png" />
    <None Remove="Assets\Images\imgBanner_3.png" />
    <None Remove="Assets\Images\imgBanner_4.png" />
    <None Remove="Assets\Images\imgBanner_5.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icoCoffee.ico" />
    <Resource Include="Assets\Images\imgBanner_4.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\cuteCoffeeCup.jpg" />
    <Resource Include="Assets\Images\imgBanner_1.png" />
    <Resource Include="Assets\Images\imgBanner_2.png" />
    <Resource Include="Assets\Images\imgBanner_3.png" />
    <Resource Include="Assets\Images\imgBanner_5.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Database\CoffeeShopDB.mdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Database\CoffeeShopDB_log.ldf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Fonts\" />
  </ItemGroup>

</Project>
