<Window x:Class="CoffeeShop.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:navigation="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Coffee Shop" 
        Icon="/CoffeeShop;component/Assets/icoCoffee.ico"
        Height="520" Width="850"
        MinHeight="520" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource MaterialDesignFont}" >
    <Grid >
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,0.5" StartPoint="0.5,1">
                <GradientStop Color="#FFB18252"/>
                <GradientStop Color="#FFE0CEB5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="White"
        CornerRadius="30"
        Height="450" Width="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="450"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,40,0,0">
                        <TextBlock Text="WELCOME"
                               Foreground="#340D05"
                               FontSize="55"
                               FontStyle="Italic"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Black" 
                               HorizontalAlignment="Center" Height="68"
                               />
                        <TextBlock x:Name="txblQuote"
                               Text="This is the funniest coffee shop."
                               FontStyle="Oblique"
                               FontFamily="Cascadia Code"
                               FontSize="13"
                               TextAlignment="Justify"
                               Margin="10 0 0 0"
                               HorizontalAlignment="Center"
                               MaxWidth="340"
                               TextWrapping="Wrap"/>
                        <TextBlock x:Name="txblAuthor"
                               Text="- Author -"
                               FontStyle="Italic"
                               FontFamily="Cascadia Code"
                               HorizontalAlignment="Right"
                               Margin="0 5 15 0"
                               VerticalAlignment="Bottom"></TextBlock>
                    </StackPanel>

                    <StackPanel Width="270" Margin="0,21,0,0">
                        <TextBlock 
                            x:Name="txblNotify"
                            Text="Sai tài khoản hoặc mật khẩu."
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="Red"
                            HorizontalAlignment="Center"/>
                        <Grid Height="40" Width="240" Margin="7">
                            <Border Background="#FFE2E2DF" CornerRadius="6">
                                <!--<TextBlock Text="Username" FontSize="8"
                                       Padding="8,10,0,0"/>-->
                                <TextBox
                                    x:Name="txbFloatingUsernameBox"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="Tên tài khoản"
                                    materialDesign:HintAssist.Foreground="#392805"
                                    materialDesign:TextFieldAssist.UnderlineBrush="#B18252"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Height="39"
                                    Margin="3 0 2.7 0.5"
                                    Padding="5,5,0,0"
                                    KeyDown="txbFloatingUsernameBox_KeyDown"
                                    />

                            </Border>
                        </Grid>
                        <Grid Height="40" Width="240" >
                            <Border Background="#FFE2E2DF" CornerRadius="6">
                                <!--<TextBlock Text="Password" FontSize="8"
                                       Padding="8,10,0,0"/>-->
                                <PasswordBox
                                    x:Name="txbFloatingPasswordBox"
                                    materialDesign:HintAssist.Foreground="#392805"
                                    materialDesign:TextFieldAssist.UnderlineBrush="#B18252"
                                    Height="39"
                                    Margin="3 0 2.7 0.5"
                                    Padding="5,5,0,0"
                                    materialDesign:HintAssist.Hint="Mật khẩu"
                                    Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                    KeyDown="txbFloatingPasswordBox_KeyDown"
                                    />
                            </Border>
                        </Grid>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock 
                                Text="Quên mật khẩu?"
                                HorizontalAlignment="Right"
                                Margin="0 5 16 0"
                                Cursor="Hand"
                                MouseLeftButtonDown="ForgotPassword_Click"/>
                            <Grid Height="35" Width="240" Margin="8 10 8 8">
                                <Border CornerRadius="6">
                                    <Button 
                                        x:Name="btnLogin"
                                        Content="ĐĂNG NHẬP" 
                                        Background="#340D05"
                                        FontSize="10"
                                        FontWeight="ExtraBold"
                                        Foreground="White" 
                                        Click="btnEvt_LoginButtonClick"
                                        />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <TextBlock FontSize="13"
                               TextAlignment="Center"
                               Margin="7">
                            <Hyperlink NavigateUri="https://hehed.carrd.co/"
                                RequestNavigate="Hyperlink_RequestNavigate"
                                Foreground="Black"
                                TextDecorations="{x:Null}">
                                - About us -
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    
                </StackPanel>

                <StackPanel Grid.Column="1" Height="415" Width="415">
                    <Image x:Name="imgBanner"
                        Source="/Assets/Images/imgBanner_3.png">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="25" RadiusY="20" Rect="0,0,415,415"/>
                        </Image.Clip>
                    </Image>
                </StackPanel>
                <Canvas>
                    <Image 
                        Source="Assets/Images/cuteCoffeeCup.jpg" Height="70" Width="70"
                        HorizontalAlignment="Left" Panel.ZIndex="0"
                        Canvas.Left="20"
                        Canvas.Bottom="5"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
