<Window x:Class="CoffeeShop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800"
        FontFamily="{DynamicResource MaterialDesignFont}" >
    <Grid>
        <Image Source="/Assets/Images/CoffeeShop1.png"
               Stretch="UniformToFill"></Image>

        <TextBlock Text="XOXO COFFEE"
                   FontFamily="Brush Script MT"
                   FontSize="65"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0 10 0 0">
        </TextBlock>
        <Border Width="300" Height="280"
                Margin="0, 40, 0, 0"
                Background="#80000000"
                CornerRadius="25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="0">

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock Width="auto" Height="28"
                           Text="Username"
                           FontFamily="Baskerville Old Face" FontSize="17"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="20 0 0 0"
                           Padding="0 10 0 0"
                           Grid.Row="0">
                </TextBlock>

                <TextBlock Width="auto" Height="28"
                           Text="Password"
                           FontFamily="Baskerville Old Face" FontSize="17"
                           Foreground="White"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="20 0 0 0"
                           Padding="0 10 0 0"
                           Grid.Row="2">
                </TextBlock>

                <TextBlock Text="Forgot Password?"
                           FontFamily="Baskerville Old Face"
                           FontSize="17"
                           TextDecorations="Underline"
                           Foreground="White"
                           Grid.Row="4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0 0 20 0"/>

                <Border Width="200" Height="28"
                        CornerRadius="4" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        Background="#FFFFEED6" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20 0 0 0"
                        Grid.Row="1">

                    <TextBox x:Name="txtUsername"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Calibri"
                             FontSize="15"
                             KeyDown="txtUsername_KeyDown">
                    </TextBox>
                </Border>

                <Border Width="200" Height="28"
                        CornerRadius="4" 
                        BorderBrush="Gray" 
                        BorderThickness="1" 
                        Background="#FFFFEED6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20 0 0 0"
                        Grid.Row="3">

                    <PasswordBox x:Name="pwdBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PasswordChar="*"
                                 FontFamily="Calibri"
                                 FontSize="15"
                                 KeyDown="pwdBox_KeyDown">
                    </PasswordBox>
                </Border>

                <Border Width="200" Height="40"
                        Background="#FFB26509"
                        CornerRadius="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0 10 0 0"
                        Grid.Row="5">

                    <Button x:Name="btnLogin"
                            Content="Login"
                            FontFamily="Baskerville Old Face"
                            FontSize="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="btnLogin_Click">
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
