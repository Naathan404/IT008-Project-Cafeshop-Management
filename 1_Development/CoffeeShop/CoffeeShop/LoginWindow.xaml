<Window x:Class="CoffeeShop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoffeeShop"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Coffee Shop" 
        Icon="/CoffeeShop;component/Assets/icoCoffee.ico"
        Height="520" Width="850"
        MinHeight="520" MinWidth="850"
        FontFamily="{DynamicResource MaterialDesignFont}" >
    <Grid >
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,0.5" StartPoint="0.5,1">
                <GradientStop Color="#FFB18252"/>
                <GradientStop Color="#FFE0CEB5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="White"
        CornerRadius="30"
        Height="450" Width="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="450"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,50,0,0">
                        <TextBlock Text="WELCOME"
                               FontSize="50"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txblQuote"
                               Text="This is the funniest coffee shop"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txblAuthor"
                               Text="Ta'c gia?"
                               HorizontalAlignment="Right"
                               Margin="0 5 15 0"
                               VerticalAlignment="Bottom"></TextBlock>
                    </StackPanel>

                    <StackPanel Width="270" Margin="0,35,0,0">
                        <Grid Height="40" Width="240" Margin="7">
                            <Border Background="#FFE2E2DF" CornerRadius="6">
                                <!--<TextBlock Text="Username" FontSize="8"
                                       Padding="8,10,0,0"/>-->
                                <TextBox
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="Tên tài khoản"
                                    materialDesign:HintAssist.Foreground="#392805"
                                    materialDesign:TextFieldAssist.UnderlineBrush="#B18252"
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                    Height="39"
                                    Margin="3 0 2.7 0.5"
                                    Padding="5,5,0,0"
                                    />

                            </Border>
                        </Grid>
                        <Grid Height="40" Width="240" >
                            <Border Background="#FFE2E2DF" CornerRadius="6">
                                <!--<TextBlock Text="Password" FontSize="8"
                                       Padding="8,10,0,0"/>-->
                                <PasswordBox
                                  x:Name="FloatingPasswordBox"
                                  materialDesign:HintAssist.Foreground="#392805"
                                  materialDesign:TextFieldAssist.UnderlineBrush="#B18252"
                                  Height="39"
                                  Margin="3 0 2.7 0.5"
                                  Padding="5,5,0,0"
                                  materialDesign:HintAssist.Hint="Mật khẩu"
                                  Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                  />
                            </Border>
                        </Grid>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="Quên mật khẩu?"
                                   HorizontalAlignment="Right"
                                   Margin="0 5 16 0"/>
                            <Grid Height="35" Width="240" Margin="8 10 8 8">
                                <Border CornerRadius="6">
                                    <Button Content="NEXT" 
                                           Background="#340D05"
                                           FontSize="10"
                                           FontWeight="ExtraBold"
                                           Foreground="White"
                                           Padding="0,0,0,0" Margin="3,0,-3,0"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Contact us" FontSize="13"
                               TextAlignment="Center"
                               Margin="7"/>
                    </StackPanel>

                    <Canvas>
                        <Image Source="Assets/Images/cuteCoffeeCup.jpg" Height="70" Width="70"
                           HorizontalAlignment="Left" Panel.ZIndex="0"
                           Canvas.Left="20"
                           Canvas.Bottom="-60"/>
                    </Canvas>
                </StackPanel>

                <StackPanel Grid.Column="1" Height="415" Width="415">
                    <Image x:Name="imgBanner"
                        Source="/Assets/Images/imgBanner_1.png">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="25" RadiusY="20" Rect="0,0,415,415"/>
                        </Image.Clip>
                    </Image>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
