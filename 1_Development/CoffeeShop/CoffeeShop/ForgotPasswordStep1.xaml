<Page x:Class="CoffeeShop.ForgotPasswordStep1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeShop"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="680"
      Title="ForgotPasswordStep1"
      MinHeight="500" MinWidth="680"
      FontFamily="{DynamicResource MaterialDesignFont}" >

    <Grid >
        <Grid.Background>
            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                <GradientStop Color="#E0CEB5"/>
                <GradientStop Color="#F9F6F0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Border Background="White"
            CornerRadius="30"
            Height="450" Width="600"
            HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Width="500" Height="100" Margin="30">
                    <TextBlock Text="THAY ĐỔI MẬT KHẨU"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,15"
                           />

                    <TextBlock Text="Nhập địa chỉ email bạn đã đăng ký và chúng tôi sẽ gửi cho bạn mã xác nhận để thay đổi mật khẩu."
                           FontSize="20"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Opacity="0.8"
                           />
                </StackPanel>

                <StackPanel Width="500" Height="60" Margin="30,0">
                    <TextBlock Text="Email address:"
                    FontSize="18"
                    FontWeight="SemiBold"
                    />

                    <TextBox x:Name="txbFloatingEmailBox"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="name@example.com"
                    materialDesign:HintAssist.Foreground="#392805"
                    materialDesign:TextFieldAssist.UnderlineBrush="#B18252"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    FontSize="15"
                    Height="39"
                    Padding="5,5,0,0"
                    KeyDown="txbFloatingEmailBox_KeyDown"
                    BorderBrush="#B18252"
                    BorderThickness="1"
                    />
                </StackPanel>

                <StackPanel Margin="40">
                    <Button x:Name="btnSendCode"
                        Content="GỬI MÃ"
                        Width="250" Height="40"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Background="#B18252"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnSendCode_Click"/>

                    <Button x:Name="btnBackToLogin"
                        Content="QUAY LẠI"
                        Width="250" Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Background="#D3D3D3"
                        Foreground="Black"
                        FontWeight="Bold"
                        Click="btnBackToLogin_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
